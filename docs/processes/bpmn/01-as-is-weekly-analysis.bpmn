<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AsIs" targetNamespace="https://grafio.example/bpmn">
  <bpmn:process id="Process_AsIsWeeklyAnalysis" name="AS-IS: ручной недельный анализ" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AsIs">
      <bpmn:lane id="Lane_Analyst" name="Финансовый аналитик">
        <bpmn:flowNodeRef>Start_AsIs</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SelectWeek</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Consolidate</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Calculate</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Reconcile</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Investigate</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SendReport</bpmn:flowNodeRef><bpmn:flowNodeRef>End_AsIs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WBExcel" name="Wildberries и Excel">
        <bpmn:flowNodeRef>Task_ExportWB</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ApplyFormulas</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Менеджер / руководитель">
        <bpmn:flowNodeRef>Task_ReviewResult</bpmn:flowNodeRef><bpmn:flowNodeRef>End_ManagerDecision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_AsIs" name="Нужен недельный результат"><bpmn:outgoing>Flow_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Task_SelectWeek" name="Выбрать неделю и кабинет"><bpmn:incoming>Flow_01</bpmn:incoming><bpmn:outgoing>Flow_02</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="Task_ExportWB" name="Выгрузить отчёты из WB"><bpmn:incoming>Flow_02</bpmn:incoming><bpmn:outgoing>Flow_03</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="Task_Consolidate" name="Свести выгрузки в Excel"><bpmn:incoming>Flow_03</bpmn:incoming><bpmn:outgoing>Flow_04</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="Task_ApplyFormulas" name="Применить формулы и справочники"><bpmn:incoming>Flow_04</bpmn:incoming><bpmn:outgoing>Flow_05</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="Task_Calculate" name="Проверить суммы и рассчитать показатели"><bpmn:incoming>Flow_05</bpmn:incoming><bpmn:outgoing>Flow_06</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Reconcile" name="Сверка сошлась?"><bpmn:incoming>Flow_06</bpmn:incoming><bpmn:outgoing>Flow_07_Yes</bpmn:outgoing><bpmn:outgoing>Flow_07_No</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Investigate" name="Искать пропуск, дубль или неизвестную операцию"><bpmn:incoming>Flow_07_No</bpmn:incoming><bpmn:outgoing>Flow_08</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_SendReport" name="Подготовить и передать результат"><bpmn:incoming>Flow_07_Yes</bpmn:incoming><bpmn:incoming>Flow_08</bpmn:incoming><bpmn:outgoing>Flow_09</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_ReviewResult" name="Использовать результат в решении"><bpmn:incoming>Flow_09</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="End_ManagerDecision" name="Решение принято"><bpmn:incoming>Flow_10</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_AsIs" targetRef="Task_SelectWeek"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SelectWeek" targetRef="Task_ExportWB"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ExportWB" targetRef="Task_Consolidate"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_Consolidate" targetRef="Task_ApplyFormulas"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_ApplyFormulas" targetRef="Task_Calculate"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_Calculate" targetRef="Gateway_Reconcile"/>
    <bpmn:sequenceFlow id="Flow_07_Yes" name="да" sourceRef="Gateway_Reconcile" targetRef="Task_SendReport"/>
    <bpmn:sequenceFlow id="Flow_07_No" name="нет" sourceRef="Gateway_Reconcile" targetRef="Task_Investigate"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_Investigate" targetRef="Task_SendReport"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_SendReport" targetRef="Task_ReviewResult"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ReviewResult" targetRef="End_ManagerDecision"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_AsIs"><bpmndi:BPMNPlane id="Plane_AsIs" bpmnElement="Process_AsIsWeeklyAnalysis">
    <bpmndi:BPMNShape id="Lane_Analyst_di" bpmnElement="Lane_Analyst" isHorizontal="true"><dc:Bounds x="80" y="80" width="1500" height="180"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_WBExcel_di" bpmnElement="Lane_WBExcel" isHorizontal="true"><dc:Bounds x="80" y="260" width="1500" height="180"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_Manager_di" bpmnElement="Lane_Manager" isHorizontal="true"><dc:Bounds x="80" y="440" width="1500" height="180"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Start_AsIs_di" bpmnElement="Start_AsIs"><dc:Bounds x="145" y="150" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_SelectWeek_di" bpmnElement="Task_SelectWeek"><dc:Bounds x="220" y="125" width="130" height="86"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_ExportWB_di" bpmnElement="Task_ExportWB"><dc:Bounds x="400" y="305" width="140" height="86"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_Consolidate_di" bpmnElement="Task_Consolidate"><dc:Bounds x="590" y="125" width="145" height="86"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_ApplyFormulas_di" bpmnElement="Task_ApplyFormulas"><dc:Bounds x="790" y="305" width="150" height="86"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_Calculate_di" bpmnElement="Task_Calculate"><dc:Bounds x="990" y="125" width="160" height="86"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Gateway_Reconcile_di" bpmnElement="Gateway_Reconcile" isMarkerVisible="true"><dc:Bounds x="1190" y="143" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_Investigate_di" bpmnElement="Task_Investigate"><dc:Bounds x="1280" y="125" width="190" height="86"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_SendReport_di" bpmnElement="Task_SendReport"><dc:Bounds x="1280" y="305" width="190" height="86"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_ReviewResult_di" bpmnElement="Task_ReviewResult"><dc:Bounds x="1280" y="485" width="190" height="86"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="End_ManagerDecision_di" bpmnElement="End_ManagerDecision"><dc:Bounds x="1510" y="512" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01"><di:waypoint x="181" y="168"/><di:waypoint x="220" y="168"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02"><di:waypoint x="350" y="168"/><di:waypoint x="370" y="168"/><di:waypoint x="370" y="348"/><di:waypoint x="400" y="348"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03"><di:waypoint x="540" y="348"/><di:waypoint x="565" y="348"/><di:waypoint x="565" y="168"/><di:waypoint x="590" y="168"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04"><di:waypoint x="735" y="168"/><di:waypoint x="760" y="168"/><di:waypoint x="760" y="348"/><di:waypoint x="790" y="348"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05"><di:waypoint x="940" y="348"/><di:waypoint x="965" y="348"/><di:waypoint x="965" y="168"/><di:waypoint x="990" y="168"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06"><di:waypoint x="1150" y="168"/><di:waypoint x="1190" y="168"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_07_Yes_di" bpmnElement="Flow_07_Yes"><di:waypoint x="1215" y="193"/><di:waypoint x="1215" y="348"/><di:waypoint x="1280" y="348"/><bpmndi:BPMNLabel><dc:Bounds x="1225" y="255" width="20" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_07_No_di" bpmnElement="Flow_07_No"><di:waypoint x="1240" y="168"/><di:waypoint x="1280" y="168"/><bpmndi:BPMNLabel><dc:Bounds x="1248" y="150" width="22" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08"><di:waypoint x="1375" y="211"/><di:waypoint x="1375" y="305"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09"><di:waypoint x="1375" y="391"/><di:waypoint x="1375" y="485"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1470" y="528"/><di:waypoint x="1510" y="530"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
