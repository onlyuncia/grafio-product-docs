<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AsIs" targetNamespace="https://grafio.example/bpmn">
  <bpmn:message id="Message_WBRequest" name="Запрос выгрузки WB" />
  <bpmn:message id="Message_WBExport" name="Выгрузки WB" />
  <bpmn:process id="Process_AsIsClient" name="AS-IS: ручной недельный анализ" isExecutable="false">
    <bpmn:laneSet id="Lanes_AsIsClient">
      <bpmn:lane id="Lane_Analyst" name="Аналитик клиента">
        <bpmn:flowNodeRef>Start_AsIs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectWeek</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestWB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_WBData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Consolidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApplyFormulas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Calculate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Reconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendReport</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Руководитель">
        <bpmn:flowNodeRef>Task_ReviewResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ManagerDecision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_AsIs" name="Нужен недельный результат">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SelectWeek" name="Выбрать неделю и кабинет">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_RequestWB" name="Запросить выгрузки WB">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Catch_WBData" name="Ожидание выгрузок WB">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Definition_Catch_WBData" messageRef="Message_WBExport" />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="Task_Consolidate" name="Свести выгрузки в Excel">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Task_ApplyFormulas" name="Применить формулы и справочники">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Calculate" name="Проверить суммы и показатели">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Reconcile" name="Сверка сошлась?">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_09_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Investigate" name="Разобрать пропуск, дубль или неизвестную операцию">
      <bpmn:incoming>Flow_09_No</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SendReport" name="Подготовить и передать результат">
      <bpmn:incoming>Flow_09_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReviewResult" name="Использовать результат в решении">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_ManagerDecision" name="Решение принято">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_AsIs" targetRef="Task_SelectWeek" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SelectWeek" targetRef="Task_RequestWB" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_RequestWB" targetRef="Catch_WBData" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Catch_WBData" targetRef="Task_Consolidate" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_Consolidate" targetRef="Task_ApplyFormulas" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_ApplyFormulas" targetRef="Task_Calculate" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_Calculate" targetRef="Gateway_Reconcile" />
    <bpmn:sequenceFlow id="Flow_09_Yes" sourceRef="Gateway_Reconcile" targetRef="Task_SendReport" name="да" />
    <bpmn:sequenceFlow id="Flow_09_No" sourceRef="Gateway_Reconcile" targetRef="Task_Investigate" name="нет" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Investigate" targetRef="Task_SendReport" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_SendReport" targetRef="Task_ReviewResult" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ReviewResult" targetRef="End_ManagerDecision" />
  </bpmn:process>
  <bpmn:process id="Process_AsIsWB" name="Выгрузки Wildberries" isExecutable="false">
    <bpmn:startEvent id="Start_WB" name="Получен запрос">
      <bpmn:outgoing>WB_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Definition_Start_WB" messageRef="Message_WBRequest" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_BuildWBExport" name="Сформировать выгрузки">
      <bpmn:incoming>WB_01</bpmn:incoming>
      <bpmn:outgoing>WB_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_WB" name="Выгрузки доступны">
      <bpmn:incoming>WB_02</bpmn:incoming>
      <bpmn:messageEventDefinition id="Definition_End_WB" messageRef="Message_WBExport" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="WB_01" sourceRef="Start_WB" targetRef="Task_BuildWBExport" />
    <bpmn:sequenceFlow id="WB_02" sourceRef="Task_BuildWBExport" targetRef="End_WB" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_AsIs" name="Ручной недельный анализ">
    <bpmn:participant id="Participant_Client" name="Команда клиента" processRef="Process_AsIsClient" />
    <bpmn:participant id="Participant_WB" name="Wildberries" processRef="Process_AsIsWB" />
    <bpmn:messageFlow id="Message_RequestWB" sourceRef="Task_RequestWB" targetRef="Start_WB" messageRef="Message_WBRequest" />
    <bpmn:messageFlow id="Message_ExportsReady" sourceRef="End_WB" targetRef="Catch_WBData" messageRef="Message_WBExport" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_AsIs">
    <bpmndi:BPMNPlane id="Plane_AsIs" bpmnElement="Collaboration_AsIs">
      <bpmndi:BPMNShape id="Shape_Participant_Client" bpmnElement="Participant_Client" isHorizontal="true">
        <dc:Bounds x="60" y="80" width="2390" height="370" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Analyst" bpmnElement="Lane_Analyst" isHorizontal="true">
        <dc:Bounds x="95" y="80" width="2355" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Manager" bpmnElement="Lane_Manager" isHorizontal="true">
        <dc:Bounds x="95" y="300" width="2355" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Participant_WB" bpmnElement="Participant_WB" isHorizontal="true">
        <dc:Bounds x="60" y="470" width="2390" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_AsIs" bpmnElement="Start_AsIs">
        <dc:Bounds x="160" y="157" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SelectWeek" bpmnElement="Task_SelectWeek">
        <dc:Bounds x="245" y="132" width="140" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_RequestWB" bpmnElement="Task_RequestWB">
        <dc:Bounds x="435" y="132" width="150" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Catch_WBData" bpmnElement="Catch_WBData">
        <dc:Bounds x="660" y="157" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="550" y="225" width="120" height="32" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Consolidate" bpmnElement="Task_Consolidate">
        <dc:Bounds x="750" y="132" width="155" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ApplyFormulas" bpmnElement="Task_ApplyFormulas">
        <dc:Bounds x="955" y="132" width="180" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Calculate" bpmnElement="Task_Calculate">
        <dc:Bounds x="1290" y="132" width="180" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Reconcile" bpmnElement="Gateway_Reconcile" isMarkerVisible="true">
        <dc:Bounds x="1520" y="150" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Investigate" bpmnElement="Task_Investigate">
        <dc:Bounds x="1630" y="95" width="190" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SendReport" bpmnElement="Task_SendReport">
        <dc:Bounds x="1870" y="132" width="190" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReviewResult" bpmnElement="Task_ReviewResult">
        <dc:Bounds x="2150" y="332" width="190" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_ManagerDecision" bpmnElement="End_ManagerDecision">
        <dc:Bounds x="2410" y="357" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_WB" bpmnElement="Start_WB">
        <dc:Bounds x="492" y="522" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_BuildWBExport" bpmnElement="Task_BuildWBExport">
        <dc:Bounds x="580" y="497" width="170" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_WB" bpmnElement="End_WB">
        <dc:Bounds x="810" y="522" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_01" bpmnElement="Flow_01">
        <di:waypoint x="196" y="175" />
        <di:waypoint x="245" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_02" bpmnElement="Flow_02">
        <di:waypoint x="385" y="175" />
        <di:waypoint x="435" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_03" bpmnElement="Flow_03">
        <di:waypoint x="585" y="175" />
        <di:waypoint x="660" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_04" bpmnElement="Flow_04">
        <di:waypoint x="696" y="175" />
        <di:waypoint x="750" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_05" bpmnElement="Flow_05">
        <di:waypoint x="905" y="175" />
        <di:waypoint x="955" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_06" bpmnElement="Flow_06">
        <di:waypoint x="1135" y="175" />
        <di:waypoint x="1290" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_08" bpmnElement="Flow_08">
        <di:waypoint x="1470" y="175" />
        <di:waypoint x="1520" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_09_No" bpmnElement="Flow_09_No">
        <di:waypoint x="1570" y="175" />
        <di:waypoint x="1600" y="175" />
        <di:waypoint x="1600" y="138" />
        <di:waypoint x="1630" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_09_Yes" bpmnElement="Flow_09_Yes">
        <di:waypoint x="1545" y="200" />
        <di:waypoint x="1545" y="258" />
        <di:waypoint x="1965" y="258" />
        <di:waypoint x="1965" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="1820" y="138" />
        <di:waypoint x="1842" y="138" />
        <di:waypoint x="1842" y="175" />
        <di:waypoint x="1870" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11">
        <di:waypoint x="2060" y="175" />
        <di:waypoint x="2105" y="175" />
        <di:waypoint x="2105" y="375" />
        <di:waypoint x="2150" y="375" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_12" bpmnElement="Flow_12">
        <di:waypoint x="2340" y="375" />
        <di:waypoint x="2410" y="375" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_WB_01" bpmnElement="WB_01">
        <di:waypoint x="528" y="540" />
        <di:waypoint x="580" y="540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_WB_02" bpmnElement="WB_02">
        <di:waypoint x="750" y="540" />
        <di:waypoint x="810" y="540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Message_RequestWB" bpmnElement="Message_RequestWB">
        <di:waypoint x="510" y="218" />
        <di:waypoint x="510" y="522" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Message_ExportsReady" bpmnElement="Message_ExportsReady">
        <di:waypoint x="828" y="522" />
        <di:waypoint x="828" y="455" />
        <di:waypoint x="678" y="455" />
        <di:waypoint x="678" y="193" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
