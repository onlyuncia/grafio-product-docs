        <dc:Bounds x="2120" y="972" width="195" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendResolution_di" bpmnElement="Task_SendResolution">
        <dc:Bounds x="2370" y="972" width="155" height="86"/>
      </bpmndi:BPMNShape>
