<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ToBeCollaboration" targetNamespace="https://grafio.example/bpmn">
  <bpmn:message id="Message_AdminResolution" name="Результат исследования или публикации методики"/>
  <bpmn:collaboration id="Collaboration_ToBe" name="TO-BE: клиентский запрос и взаимодействие">
    <bpmn:participant id="Participant_Client" name="Клиентская организация" processRef="Process_Client"/>
    <bpmn:participant id="Participant_Grafio" name="Grafio: данные и расчёт" processRef="Process_Grafio"/>
    <bpmn:participant id="Participant_Admin" name="Admin Console Grafio" processRef="Process_Admin"/>
    <bpmn:participant id="Participant_WB" name="Wildberries API" processRef="Process_WB"/>
    <bpmn:messageFlow id="Message_RequestReport" name="Запрос отчёта" sourceRef="Task_RequestReport" targetRef="Start_Grafio"/>
    <bpmn:messageFlow id="Message_RequestWB" name="Запрос финансовых данных" sourceRef="Task_RequestData" targetRef="Start_WB"/>
    <bpmn:messageFlow id="Message_WBResponse" name="Финансовые данные" sourceRef="End_WB" targetRef="Task_RequestData"/>
    <bpmn:messageFlow id="Message_PublishedReport" name="Версия отчёта и статус качества" sourceRef="Task_PublishReport" targetRef="Catch_Report"/>
    <bpmn:messageFlow id="Message_QualityIssue" name="Статус проверки и прежняя версия" sourceRef="Task_BlockPublication" targetRef="Catch_Report"/>
    <bpmn:messageFlow id="Message_Case" name="Кейс и доказательства" sourceRef="Task_CreateCase" targetRef="Start_Admin"/>
    <bpmn:messageFlow id="Message_AdminResult" name="Результат исследования / публикации" sourceRef="End_Admin" targetRef="Catch_AdminResult" messageRef="Message_AdminResolution"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Client" name="Клиентский процесс" isExecutable="false">
    <bpmn:startEvent id="Start_Client" name="Нужен недельный результат">
      <bpmn:outgoing>C01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_RequestReport" name="Выбрать кабинет и неделю">
      <bpmn:incoming>C01</bpmn:incoming>
      <bpmn:outgoing>C02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Catch_Report" name="Получить отчёт или статус">
      <bpmn:incoming>C02</bpmn:incoming>
      <bpmn:outgoing>C03</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_Explore" name="Проверить доступный результат и статус">
      <bpmn:incoming>C03</bpmn:incoming>
      <bpmn:outgoing>C04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Problem" name="Есть проблема?">
      <bpmn:incoming>C04</bpmn:incoming>
      <bpmn:outgoing>C05_Yes</bpmn:outgoing>
      <bpmn:outgoing>C05_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CreateCase" name="Создать кейс и приложить доказательства">
      <bpmn:incoming>C05_Yes</bpmn:incoming>
      <bpmn:outgoing>C06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Catch_AdminResult" name="Получить результат">
      <bpmn:incoming>C06</bpmn:incoming>
      <bpmn:outgoing>C07</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Client" name="Результат использован">
      <bpmn:incoming>C05_No</bpmn:incoming>
      <bpmn:incoming>C07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="C01" sourceRef="Start_Client" targetRef="Task_RequestReport"/>
    <bpmn:sequenceFlow id="C02" sourceRef="Task_RequestReport" targetRef="Catch_Report"/>
    <bpmn:sequenceFlow id="C03" sourceRef="Catch_Report" targetRef="Task_Explore"/>
    <bpmn:sequenceFlow id="C04" sourceRef="Task_Explore" targetRef="Gateway_Problem"/>
    <bpmn:sequenceFlow id="C05_Yes" name="да" sourceRef="Gateway_Problem" targetRef="Task_CreateCase"/>
    <bpmn:sequenceFlow id="C05_No" name="нет" sourceRef="Gateway_Problem" targetRef="End_Client"/>
    <bpmn:sequenceFlow id="C06" sourceRef="Task_CreateCase" targetRef="Catch_AdminResult"/>
    <bpmn:sequenceFlow id="C07" sourceRef="Catch_AdminResult" targetRef="End_Client"/>
  </bpmn:process>
  <bpmn:process id="Process_Grafio" name="Получение и расчёт Grafio" isExecutable="false">
    <bpmn:dataObject id="Data_Raw" name="Raw-ответ WB"/>
    <bpmn:dataObjectReference id="DataRef_Raw" dataObjectRef="Data_Raw" name="Raw-ответ WB"/>
    <bpmn:dataObject id="Data_Operations" name="Нормализованные операции"/>
    <bpmn:dataObjectReference id="DataRef_Operations" dataObjectRef="Data_Operations" name="Операции"/>
    <bpmn:dataObject id="Data_ReportVersion" name="Версия отчёта"/>
    <bpmn:dataObjectReference id="DataRef_ReportVersion" dataObjectRef="Data_ReportVersion" name="Версия отчёта"/>
    <bpmn:startEvent id="Start_Grafio" name="Получен запрос отчёта">
      <bpmn:outgoing>G01</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_RequestData" name="Получить финансовые данные WB">
      <bpmn:incoming>G01</bpmn:incoming>
      <bpmn:incoming>G_Retry</bpmn:incoming>
      <bpmn:outgoing>G02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_WBTimeout" name="Таймаут / лимит WB" attachedToRef="Task_RequestData">
      <bpmn:outgoing>G_Timeout</bpmn:outgoing>
      <bpmn:timerEventDefinition/>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_ScheduleRetry" name="Запланировать идемпотентный повтор">
      <bpmn:incoming>G_Timeout</bpmn:incoming>
      <bpmn:outgoing>G_Retry</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_NormalizeQuality" name="Нормализовать, классифицировать и сверить">
      <bpmn:incoming>G02</bpmn:incoming>
      <bpmn:outgoing>G03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Calculable" name="Нет блокирующих нарушений и Δ = 0?">
      <bpmn:incoming>G03</bpmn:incoming>
      <bpmn:outgoing>G04_Yes</bpmn:outgoing>
      <bpmn:outgoing>G04_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Calculate" name="Классифицировать и рассчитать">
      <bpmn:incoming>G04_Yes</bpmn:incoming>
      <bpmn:outgoing>G05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PublishReport" name="Опубликовать полную или ограниченную версию">
      <bpmn:incoming>G05</bpmn:incoming>
      <bpmn:outgoing>G06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_BlockPublication" name="Сохранить непубликуемую версию и сигнал">
      <bpmn:incoming>G04_No</bpmn:incoming>
      <bpmn:outgoing>G07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Grafio">
      <bpmn:incoming>G06</bpmn:incoming>
      <bpmn:incoming>G07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:association id="Association_Raw" sourceRef="Task_RequestData" targetRef="DataRef_Raw"/>
    <bpmn:association id="Association_Operations" sourceRef="Task_NormalizeQuality" targetRef="DataRef_Operations"/>
    <bpmn:association id="Association_Report" sourceRef="Task_PublishReport" targetRef="DataRef_ReportVersion"/>
    <bpmn:sequenceFlow id="G01" sourceRef="Start_Grafio" targetRef="Task_RequestData"/>
    <bpmn:sequenceFlow id="G02" sourceRef="Task_RequestData" targetRef="Task_NormalizeQuality"/>
    <bpmn:sequenceFlow id="G_Timeout" sourceRef="Boundary_WBTimeout" targetRef="Task_ScheduleRetry"/>
    <bpmn:sequenceFlow id="G_Retry" sourceRef="Task_ScheduleRetry" targetRef="Task_RequestData"/>
    <bpmn:sequenceFlow id="G03" sourceRef="Task_NormalizeQuality" targetRef="Gateway_Calculable"/>
    <bpmn:sequenceFlow id="G04_Yes" name="да" sourceRef="Gateway_Calculable" targetRef="Task_Calculate"/>
    <bpmn:sequenceFlow id="G04_No" name="нет" sourceRef="Gateway_Calculable" targetRef="Task_BlockPublication"/>
    <bpmn:sequenceFlow id="G05" sourceRef="Task_Calculate" targetRef="Task_PublishReport"/>
    <bpmn:sequenceFlow id="G06" sourceRef="Task_PublishReport" targetRef="End_Grafio"/>
    <bpmn:sequenceFlow id="G07" sourceRef="Task_BlockPublication" targetRef="End_Grafio"/>
  </bpmn:process>
  <bpmn:process id="Process_Admin" name="Admin Console" isExecutable="false">
    <bpmn:startEvent id="Start_Admin" name="Получен клиентский кейс">
      <bpmn:outgoing>A01</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Investigate" name="Исследовать кейс и область воздействия">
      <bpmn:incoming>A01</bpmn:incoming>
      <bpmn:outgoing>A02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MethodChange" name="Нужна новая методика?">
      <bpmn:incoming>A02</bpmn:incoming>
      <bpmn:outgoing>A03_Yes</bpmn:outgoing>
      <bpmn:outgoing>A03_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SubProcess_PublishMethodology" name="Проверить и опубликовать методику (BPMN-03)">
      <bpmn:incoming>A03_Yes</bpmn:incoming>
      <bpmn:outgoing>A04</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:userTask id="Task_SendResolution" name="Подготовить ответ клиенту">
      <bpmn:incoming>A03_No</bpmn:incoming>
      <bpmn:incoming>A04</bpmn:incoming>
      <bpmn:outgoing>A05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Admin" name="Ответ клиенту отправлен">
      <bpmn:incoming>A05</bpmn:incoming>
      <bpmn:messageEventDefinition id="Definition_End_Admin" messageRef="Message_AdminResolution"/>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="A01" sourceRef="Start_Admin" targetRef="Task_Investigate"/>
    <bpmn:sequenceFlow id="A02" sourceRef="Task_Investigate" targetRef="Gateway_MethodChange"/>
    <bpmn:sequenceFlow id="A03_Yes" name="да" sourceRef="Gateway_MethodChange" targetRef="SubProcess_PublishMethodology"/>
    <bpmn:sequenceFlow id="A03_No" name="нет" sourceRef="Gateway_MethodChange" targetRef="Task_SendResolution"/>
    <bpmn:sequenceFlow id="A04" sourceRef="SubProcess_PublishMethodology" targetRef="Task_SendResolution"/>
    <bpmn:sequenceFlow id="A05" sourceRef="Task_SendResolution" targetRef="End_Admin"/>
  </bpmn:process>
  <bpmn:process id="Process_WB" name="Wildberries API" isExecutable="false">
    <bpmn:startEvent id="Start_WB" name="Запрос данных">
      <bpmn:outgoing>W01</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ReturnWBData" name="Вернуть финансовые данные">
      <bpmn:incoming>W01</bpmn:incoming>
      <bpmn:outgoing>W02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_WB" name="Ответ API">
      <bpmn:incoming>W02</bpmn:incoming>
      <bpmn:messageEventDefinition/>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="W01" sourceRef="Start_WB" targetRef="Task_ReturnWBData"/>
    <bpmn:sequenceFlow id="W02" sourceRef="Task_ReturnWBData" targetRef="End_WB"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ToBeCollaboration">
    <bpmndi:BPMNPlane id="Plane_ToBeCollaboration" bpmnElement="Collaboration_ToBe">
      <bpmndi:BPMNShape id="Participant_Client_di" bpmnElement="Participant_Client" isHorizontal="true">
        <dc:Bounds x="60" y="660" width="2600" height="210"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Grafio_di" bpmnElement="Participant_Grafio" isHorizontal="true">
        <dc:Bounds x="60" y="270" width="2600" height="350"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Admin_di" bpmnElement="Participant_Admin" isHorizontal="true">
        <dc:Bounds x="60" y="910" width="2600" height="210"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_WB_di" bpmnElement="Participant_WB" isHorizontal="true">
        <dc:Bounds x="60" y="80" width="2600" height="150"/>
      </bpmndi:BPMNShape>
