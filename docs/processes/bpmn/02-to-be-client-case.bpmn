      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="G07_di" bpmnElement="G07">
        <di:waypoint x="1150" y="505"/>
        <di:waypoint x="1430" y="505"/>
        <di:waypoint x="1430" y="408"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="C01_di" bpmnElement="C01">
        <di:waypoint x="168" y="765"/>
        <di:waypoint x="230" y="765"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="C02_di" bpmnElement="C02">
        <di:waypoint x="375" y="765"/>
        <di:waypoint x="1249" y="765"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="C03_di" bpmnElement="C03">
        <di:waypoint x="1285" y="765"/>
        <di:waypoint x="1340" y="765"/>
