      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="G03_di" bpmnElement="G03">
        <di:waypoint x="800" y="390"/>
        <di:waypoint x="850" y="390"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="G04_Yes_di" bpmnElement="G04_Yes">
        <di:waypoint x="900" y="390"/>
