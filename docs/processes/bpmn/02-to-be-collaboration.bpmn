    <bpmndi:BPMNShape id="Start_Grafio_di" bpmnElement="Start_Grafio"><dc:Bounds x="205" y="335" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_RequestData_di" bpmnElement="Task_RequestData"><dc:Bounds x="285" y="310" width="155" height="86"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Boundary_WBTimeout_di" bpmnElement="Boundary_WBTimeout"><dc:Bounds x="388" y="378" width="30" height="30"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_ScheduleRetry_di" bpmnElement="Task_ScheduleRetry"><dc:Bounds x="285" y="410" width="155" height="40"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_NormalizeQuality_di" bpmnElement="Task_NormalizeQuality"><dc:Bounds x="500" y="310" width="175" height="86"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gateway_Calculable_di" bpmnElement="Gateway_Calculable" isMarkerVisible="true"><dc:Bounds x="730" y="328" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_Calculate_di" bpmnElement="Task_Calculate"><dc:Bounds x="830" y="280" width="155" height="86"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_PublishReport_di" bpmnElement="Task_PublishReport"><dc:Bounds x="1040" y="280" width="155" height="86"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_PublishLimited_di" bpmnElement="Task_PublishLimited"><dc:Bounds x="830" y="380" width="190" height="60"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_Grafio_di" bpmnElement="End_Grafio"><dc:Bounds x="1250" y="330" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DataRef_Raw_di" bpmnElement="DataRef_Raw"><dc:Bounds x="350" y="270" width="36" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DataRef_Operations_di" bpmnElement="DataRef_Operations"><dc:Bounds x="585" y="270" width="36" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DataRef_ReportVersion_di" bpmnElement="DataRef_ReportVersion"><dc:Bounds x="1110" y="230" width="36" height="50"/></bpmndi:BPMNShape>
