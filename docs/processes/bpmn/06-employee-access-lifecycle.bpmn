<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Access" targetNamespace="https://grafio.example/bpmn"><bpmn:process id="Process_Access" name="Жизненный цикл доступа сотрудника" isExecutable="false"><bpmn:laneSet id="Lanes_Access"><bpmn:lane id="Lane_AccessOwner" name="Владелец организации"><bpmn:flowNodeRef>Start_A</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Invite</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AssignRole</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Revoke</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Revoke</bpmn:flowNodeRef><bpmn:flowNodeRef>End_A</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Employee" name="Сотрудник"><bpmn:flowNodeRef>Task_Accept</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Set2FA</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_AccessSystem" name="Grafio"><bpmn:flowNodeRef>Task_CreateMembership</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_2FA</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_GrantScope</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AuditAccess</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CloseSessions</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Start_A" name="Нужен доступ сотруднику"><bpmn:outgoing>A01</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="Task_Invite" name="Пригласить сотрудника"><bpmn:incoming>A01</bpmn:incoming><bpmn:outgoing>A02</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_Accept" name="Принять приглашение"><bpmn:incoming>A02</bpmn:incoming><bpmn:outgoing>A03</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Task_CreateMembership" name="Создать членство без активного доступа"><bpmn:incoming>A03</bpmn:incoming><bpmn:outgoing>A04</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="Task_AssignRole" name="Назначить роль и область"><bpmn:incoming>A04</bpmn:incoming><bpmn:outgoing>A05</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_2FA" name="Для роли обязательна 2FA?"><bpmn:incoming>A05</bpmn:incoming><bpmn:outgoing>A06_Yes</bpmn:outgoing><bpmn:outgoing>A06_No</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_Set2FA" name="Настроить 2FA"><bpmn:incoming>A06_Yes</bpmn:incoming><bpmn:outgoing>A07</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Task_GrantScope" name="Активировать доступ в области"><bpmn:incoming>A06_No</bpmn:incoming><bpmn:incoming>A07</bpmn:incoming><bpmn:outgoing>A08</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Task_AuditAccess" name="Записать аудит изменения"><bpmn:incoming>A08</bpmn:incoming><bpmn:outgoing>A09</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Gateway_Revoke" name="Доступ нужно отозвать?"><bpmn:incoming>A09</bpmn:incoming><bpmn:outgoing>A10_Yes</bpmn:outgoing><bpmn:outgoing>A10_No</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_Revoke" name="Отозвать роль или доступ"><bpmn:incoming>A10_Yes</bpmn:incoming><bpmn:outgoing>A11</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Task_CloseSessions" name="Завершить сессии и зафиксировать аудит"><bpmn:incoming>A11</bpmn:incoming><bpmn:outgoing>A12</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="End_A" name="Доступ активен или отозван"><bpmn:incoming>A10_No</bpmn:incoming><bpmn:incoming>A12</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="A01" sourceRef="Start_A" targetRef="Task_Invite"/><bpmn:sequenceFlow id="A02" sourceRef="Task_Invite" targetRef="Task_Accept"/><bpmn:sequenceFlow id="A03" sourceRef="Task_Accept" targetRef="Task_CreateMembership"/><bpmn:sequenceFlow id="A04" sourceRef="Task_CreateMembership" targetRef="Task_AssignRole"/><bpmn:sequenceFlow id="A05" sourceRef="Task_AssignRole" targetRef="Gateway_2FA"/><bpmn:sequenceFlow id="A06_Yes" name="да" sourceRef="Gateway_2FA" targetRef="Task_Set2FA"/><bpmn:sequenceFlow id="A06_No" name="нет" sourceRef="Gateway_2FA" targetRef="Task_GrantScope"/><bpmn:sequenceFlow id="A07" sourceRef="Task_Set2FA" targetRef="Task_GrantScope"/><bpmn:sequenceFlow id="A08" sourceRef="Task_GrantScope" targetRef="Task_AuditAccess"/><bpmn:sequenceFlow id="A09" sourceRef="Task_AuditAccess" targetRef="Gateway_Revoke"/><bpmn:sequenceFlow id="A10_Yes" name="да" sourceRef="Gateway_Revoke" targetRef="Task_Revoke"/><bpmn:sequenceFlow id="A10_No" name="нет" sourceRef="Gateway_Revoke" targetRef="End_A"/><bpmn:sequenceFlow id="A11" sourceRef="Task_Revoke" targetRef="Task_CloseSessions"/><bpmn:sequenceFlow id="A12" sourceRef="Task_CloseSessions" targetRef="End_A"/></bpmn:process></bpmn:definitions>
