        <di:waypoint x="1867.5" y="140.0" />
        <di:waypoint x="1890" y="140.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A10_Yes" bpmnElement="A10_Yes">
        <di:waypoint x="1940" y="140" />
        <di:waypoint x="1990" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A10_No" bpmnElement="A10_No">
        <di:waypoint x="1915" y="115" />
