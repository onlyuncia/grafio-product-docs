      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A11" bpmnElement="A11">
        <di:waypoint x="2075" y="183" />
        <di:waypoint x="2075" y="425" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A12" bpmnElement="A12">
        <di:waypoint x="2170" y="470" />
        <di:waypoint x="2210" y="470" />
        <di:waypoint x="2210" y="140" />
        <di:waypoint x="2240" y="140" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
