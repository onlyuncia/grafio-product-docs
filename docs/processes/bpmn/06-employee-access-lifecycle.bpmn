<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Access" targetNamespace="https://grafio.example/bpmn">
  <bpmn:process id="Process_Access" name="Жизненный цикл доступа сотрудника" isExecutable="false">
    <bpmn:laneSet id="Lanes_Access">
      <bpmn:lane id="Lane_AccessOwner" name="Владелец организации">
        <bpmn:flowNodeRef>Start_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignRole</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Revoke</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Revoke</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_A</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Employee" name="Сотрудник">
        <bpmn:flowNodeRef>Task_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Set2FA</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AccessSystem" name="Grafio">
        <bpmn:flowNodeRef>Task_CreateMembership</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_2FA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GrantScope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AuditAccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseSessions</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_A" name="Нужен доступ сотруднику">
      <bpmn:outgoing>A01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Invite" name="Пригласить сотрудника">
      <bpmn:incoming>A01</bpmn:incoming>
      <bpmn:outgoing>A02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Accept" name="Принять приглашение">
      <bpmn:incoming>A02</bpmn:incoming>
      <bpmn:outgoing>A03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_CreateMembership" name="Создать членство без активного доступа">
      <bpmn:incoming>A03</bpmn:incoming>
      <bpmn:outgoing>A04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_AssignRole" name="Назначить роль и область">
      <bpmn:incoming>A04</bpmn:incoming>
      <bpmn:outgoing>A05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_2FA" name="Для роли обязательна 2FA?">
      <bpmn:incoming>A05</bpmn:incoming>
      <bpmn:outgoing>A06_Yes</bpmn:outgoing>
      <bpmn:outgoing>A06_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Set2FA" name="Настроить 2FA">
      <bpmn:incoming>A06_Yes</bpmn:incoming>
      <bpmn:outgoing>A07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_GrantScope" name="Активировать доступ в области">
      <bpmn:incoming>A06_No</bpmn:incoming>
      <bpmn:incoming>A07</bpmn:incoming>
      <bpmn:outgoing>A08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AuditAccess" name="Записать аудит изменения">
      <bpmn:incoming>A08</bpmn:incoming>
      <bpmn:outgoing>A09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Revoke" name="Доступ нужно отозвать?">
      <bpmn:incoming>A09</bpmn:incoming>
      <bpmn:outgoing>A10_Yes</bpmn:outgoing>
      <bpmn:outgoing>A10_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Revoke" name="Отозвать роль или доступ">
      <bpmn:incoming>A10_Yes</bpmn:incoming>
      <bpmn:outgoing>A11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_CloseSessions" name="Завершить сессии и зафиксировать аудит">
      <bpmn:incoming>A11</bpmn:incoming>
      <bpmn:outgoing>A12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_A" name="Доступ активен или отозван">
      <bpmn:incoming>A10_No</bpmn:incoming>
      <bpmn:incoming>A12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="A01" sourceRef="Start_A" targetRef="Task_Invite" />
    <bpmn:sequenceFlow id="A02" sourceRef="Task_Invite" targetRef="Task_Accept" />
    <bpmn:sequenceFlow id="A03" sourceRef="Task_Accept" targetRef="Task_CreateMembership" />
    <bpmn:sequenceFlow id="A04" sourceRef="Task_CreateMembership" targetRef="Task_AssignRole" />
    <bpmn:sequenceFlow id="A05" sourceRef="Task_AssignRole" targetRef="Gateway_2FA" />
    <bpmn:sequenceFlow id="A06_Yes" name="да" sourceRef="Gateway_2FA" targetRef="Task_Set2FA" />
    <bpmn:sequenceFlow id="A06_No" name="нет" sourceRef="Gateway_2FA" targetRef="Task_GrantScope" />
    <bpmn:sequenceFlow id="A07" sourceRef="Task_Set2FA" targetRef="Task_GrantScope" />
    <bpmn:sequenceFlow id="A08" sourceRef="Task_GrantScope" targetRef="Task_AuditAccess" />
    <bpmn:sequenceFlow id="A09" sourceRef="Task_AuditAccess" targetRef="Gateway_Revoke" />
    <bpmn:sequenceFlow id="A10_Yes" name="да" sourceRef="Gateway_Revoke" targetRef="Task_Revoke" />
    <bpmn:sequenceFlow id="A10_No" name="нет" sourceRef="Gateway_Revoke" targetRef="End_A" />
    <bpmn:sequenceFlow id="A11" sourceRef="Task_Revoke" targetRef="Task_CloseSessions" />
    <bpmn:sequenceFlow id="A12" sourceRef="Task_CloseSessions" targetRef="End_A" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_Access">
    <bpmndi:BPMNPlane id="Plane_Process_Access" bpmnElement="Process_Access">
      <bpmndi:BPMNShape id="Shape_Lane_AccessOwner" bpmnElement="Lane_AccessOwner">
        <dc:Bounds x="60" y="60" width="2260" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Employee" bpmnElement="Lane_Employee">
        <dc:Bounds x="60" y="220" width="2260" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_AccessSystem" bpmnElement="Lane_AccessSystem">
        <dc:Bounds x="60" y="380" width="2260" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_A" bpmnElement="Start_A">
        <dc:Bounds x="120" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Invite" bpmnElement="Task_Invite">
        <dc:Bounds x="205" y="97" width="170" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Accept" bpmnElement="Task_Accept">
        <dc:Bounds x="425" y="257" width="170" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CreateMembership" bpmnElement="Task_CreateMembership">
        <dc:Bounds x="645" y="425" width="180" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_AssignRole" bpmnElement="Task_AssignRole">
        <dc:Bounds x="875" y="97" width="170" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_2FA" bpmnElement="Gateway_2FA">
        <dc:Bounds x="1090" y="445" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Set2FA" bpmnElement="Task_Set2FA">
        <dc:Bounds x="1195" y="257" width="165" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_GrantScope" bpmnElement="Task_GrantScope">
        <dc:Bounds x="1435" y="425" width="180" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_AuditAccess" bpmnElement="Task_AuditAccess">
        <dc:Bounds x="1665" y="425" width="180" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Revoke" bpmnElement="Gateway_Revoke">
        <dc:Bounds x="1890" y="115" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Revoke" bpmnElement="Task_Revoke">
        <dc:Bounds x="1990" y="97" width="170" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CloseSessions" bpmnElement="Task_CloseSessions">
        <dc:Bounds x="1990" y="425" width="180" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_A" bpmnElement="End_A">
        <dc:Bounds x="2240" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_A01" bpmnElement="A01">
        <di:waypoint x="156" y="140.0" />
        <di:waypoint x="205" y="140.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A02" bpmnElement="A02">
        <di:waypoint x="375" y="140.0" />
        <di:waypoint x="400.0" y="140.0" />
        <di:waypoint x="400.0" y="300.0" />
        <di:waypoint x="425" y="300.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A03" bpmnElement="A03">
        <di:waypoint x="595" y="300.0" />
        <di:waypoint x="620.0" y="300.0" />
        <di:waypoint x="620.0" y="470.0" />
        <di:waypoint x="645" y="470.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A04" bpmnElement="A04">
        <di:waypoint x="825" y="470.0" />
        <di:waypoint x="850.0" y="470.0" />
        <di:waypoint x="850.0" y="140.0" />
        <di:waypoint x="875" y="140.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A05" bpmnElement="A05">
        <di:waypoint x="1045" y="140.0" />
        <di:waypoint x="1067.5" y="140.0" />
        <di:waypoint x="1067.5" y="470.0" />
        <di:waypoint x="1090" y="470.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A06_Yes" bpmnElement="A06_Yes">
        <di:waypoint x="1115" y="445" />
        <di:waypoint x="1115" y="300" />
        <di:waypoint x="1195" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A06_No" bpmnElement="A06_No">
        <di:waypoint x="1140" y="470" />
        <di:waypoint x="1435" y="470" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A07" bpmnElement="A07">
        <di:waypoint x="1360" y="300" />
        <di:waypoint x="1390" y="300" />
        <di:waypoint x="1390" y="470" />
        <di:waypoint x="1435" y="470" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A08" bpmnElement="A08">
        <di:waypoint x="1615" y="470.0" />
        <di:waypoint x="1665" y="470.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A09" bpmnElement="A09">
        <di:waypoint x="1845" y="470.0" />
