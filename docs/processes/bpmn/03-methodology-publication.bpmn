<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_MethodologyPublication" targetNamespace="https://grafio.example/bpmn">
  <bpmn:process id="Process_MethodologyPublication" name="Публикация методики" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_MethodologyPublication">
      <bpmn:lane id="Lane_Admin" name="Администратор Grafio">
        <bpmn:flowNodeRef>Start_M</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Scope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Analyse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Revise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Publish</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Calc" name="Контур расчёта Grafio">
        <bpmn:flowNodeRef>Task_Control</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Recalculate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Forward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Applied</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_M" name="Системный сигнал или клиентский кейс">
      <bpmn:outgoing>M01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Scope" name="Подтвердить область и период">
      <bpmn:incoming>M01</bpmn:incoming>
      <bpmn:outgoing>M02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Analyse" name="Исследовать структуру, операции и правило">
      <bpmn:incoming>M02</bpmn:incoming>
      <bpmn:outgoing>M03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Change" name="Нужно менять методику?">
      <bpmn:incoming>M03</bpmn:incoming>
      <bpmn:outgoing>M04_No</bpmn:outgoing>
      <bpmn:outgoing>M04_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Close" name="Зафиксировать решение без нового правила">
      <bpmn:incoming>M04_No</bpmn:incoming>
      <bpmn:outgoing>M05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_NoChange" name="Закрыто">
      <bpmn:incoming>M05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Draft" name="Подготовить проект правила и способ применения">
      <bpmn:incoming>M04_Yes</bpmn:incoming>
      <bpmn:incoming>M09</bpmn:incoming>
      <bpmn:outgoing>M06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Control" name="Проверить проект расчётом и сверкой">
      <bpmn:incoming>M06</bpmn:incoming>
      <bpmn:outgoing>M07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Ready" name="Проверки пройдены и Δ = 0?">
      <bpmn:incoming>M07</bpmn:incoming>
      <bpmn:outgoing>M08_No</bpmn:outgoing>
      <bpmn:outgoing>M08_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Revise" name="Доработать проект правила">
      <bpmn:incoming>M08_No</bpmn:incoming>
      <bpmn:outgoing>M09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Publish" name="Опубликовать версию методики">
      <bpmn:incoming>M08_Yes</bpmn:incoming>
      <bpmn:outgoing>M10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Apply" name="Выбран пересчёт истории?">
      <bpmn:incoming>M10</bpmn:incoming>
      <bpmn:outgoing>M11_Yes</bpmn:outgoing>
      <bpmn:outgoing>M11_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Recalculate" name="Создать новые версии затронутых недель">
      <bpmn:incoming>M11_Yes</bpmn:incoming>
      <bpmn:outgoing>M12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Forward" name="Применить методику с выбранной даты">
      <bpmn:incoming>M11_No</bpmn:incoming>
      <bpmn:outgoing>M13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Merge" name="">
      <bpmn:incoming>M12</bpmn:incoming>
      <bpmn:incoming>M13</bpmn:incoming>
      <bpmn:outgoing>M14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Applied" name="Методика применена">
      <bpmn:incoming>M14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="M01" sourceRef="Start_M" targetRef="Task_Scope"/>
    <bpmn:sequenceFlow id="M02" sourceRef="Task_Scope" targetRef="Task_Analyse"/>
    <bpmn:sequenceFlow id="M03" sourceRef="Task_Analyse" targetRef="Gateway_Change"/>
    <bpmn:sequenceFlow id="M04_No" sourceRef="Gateway_Change" targetRef="Task_Close" name="нет"/>
    <bpmn:sequenceFlow id="M05" sourceRef="Task_Close" targetRef="End_NoChange"/>
    <bpmn:sequenceFlow id="M04_Yes" sourceRef="Gateway_Change" targetRef="Task_Draft" name="да"/>
    <bpmn:sequenceFlow id="M06" sourceRef="Task_Draft" targetRef="Task_Control"/>
    <bpmn:sequenceFlow id="M07" sourceRef="Task_Control" targetRef="Gateway_Ready"/>
    <bpmn:sequenceFlow id="M08_No" sourceRef="Gateway_Ready" targetRef="Task_Revise" name="нет"/>
    <bpmn:sequenceFlow id="M09" sourceRef="Task_Revise" targetRef="Task_Draft"/>
    <bpmn:sequenceFlow id="M08_Yes" sourceRef="Gateway_Ready" targetRef="Task_Publish" name="да"/>
    <bpmn:sequenceFlow id="M10" sourceRef="Task_Publish" targetRef="Gateway_Apply"/>
    <bpmn:sequenceFlow id="M11_Yes" sourceRef="Gateway_Apply" targetRef="Task_Recalculate" name="да"/>
    <bpmn:sequenceFlow id="M11_No" sourceRef="Gateway_Apply" targetRef="Task_Forward" name="нет"/>
    <bpmn:sequenceFlow id="M12" sourceRef="Task_Recalculate" targetRef="Gateway_Merge"/>
    <bpmn:sequenceFlow id="M13" sourceRef="Task_Forward" targetRef="Gateway_Merge"/>
    <bpmn:sequenceFlow id="M14" sourceRef="Gateway_Merge" targetRef="End_Applied"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_MethodologyPublication">
    <bpmndi:BPMNPlane id="Plane_Process_MethodologyPublication" bpmnElement="Process_MethodologyPublication">
      <bpmndi:BPMNShape id="Lane_Admin_di" bpmnElement="Lane_Admin" isHorizontal="true">
        <dc:Bounds x="60" y="60" width="2110" height="280"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Calc_di" bpmnElement="Lane_Calc" isHorizontal="true">
        <dc:Bounds x="60" y="340" width="2110" height="230"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_M_di" bpmnElement="Start_M">
        <dc:Bounds x="170" y="172" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Scope_di" bpmnElement="Task_Scope">
        <dc:Bounds x="250" y="148" width="155" height="84"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Analyse_di" bpmnElement="Task_Analyse">
        <dc:Bounds x="445" y="148" width="180" height="84"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Change_di" bpmnElement="Gateway_Change" isMarkerVisible="true">
        <dc:Bounds x="650" y="165" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Close_di" bpmnElement="Task_Close">
        <dc:Bounds x="700" y="252" width="155" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_NoChange_di" bpmnElement="End_NoChange">
        <dc:Bounds x="900" y="269" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Draft_di" bpmnElement="Task_Draft">
        <dc:Bounds x="790" y="148" width="170" height="84"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Control_di" bpmnElement="Task_Control">
        <dc:Bounds x="1010" y="390" width="190" height="85"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Ready_di" bpmnElement="Gateway_Ready" isMarkerVisible="true">
        <dc:Bounds x="1250" y="408" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Revise_di" bpmnElement="Task_Revise">
        <dc:Bounds x="1080" y="245" width="185" height="75"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Publish_di" bpmnElement="Task_Publish">
        <dc:Bounds x="1400" y="148" width="180" height="84"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Apply_di" bpmnElement="Gateway_Apply" isMarkerVisible="true">
        <dc:Bounds x="1630" y="408" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Recalculate_di" bpmnElement="Task_Recalculate">
        <dc:Bounds x="1740" y="370" width="185" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Forward_di" bpmnElement="Task_Forward">
        <dc:Bounds x="1740" y="480" width="185" height="75"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Merge_di" bpmnElement="Gateway_Merge" isMarkerVisible="true">
        <dc:Bounds x="1980" y="430" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Applied_di" bpmnElement="End_Applied">
        <dc:Bounds x="2090" y="437" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="M01_di" bpmnElement="M01">
        <di:waypoint x="206" y="190"/>
        <di:waypoint x="250" y="190"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M02_di" bpmnElement="M02">
        <di:waypoint x="405" y="190"/>
        <di:waypoint x="445" y="190"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M03_di" bpmnElement="M03">
        <di:waypoint x="625" y="190"/>
        <di:waypoint x="650" y="190"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M04_No_di" bpmnElement="M04_No">
        <di:waypoint x="675" y="215"/>
        <di:waypoint x="675" y="287"/>
        <di:waypoint x="700" y="287"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M05_di" bpmnElement="M05">
        <di:waypoint x="855" y="287"/>
        <di:waypoint x="900" y="287"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M04_Yes_di" bpmnElement="M04_Yes">
        <di:waypoint x="700" y="190"/>
        <di:waypoint x="790" y="190"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M06_di" bpmnElement="M06">
        <di:waypoint x="960" y="190"/>
        <di:waypoint x="985" y="190"/>
        <di:waypoint x="985" y="432"/>
        <di:waypoint x="1010" y="432"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M07_di" bpmnElement="M07">
        <di:waypoint x="1200" y="432"/>
        <di:waypoint x="1250" y="432"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M08_No_di" bpmnElement="M08_No">
        <di:waypoint x="1275" y="408"/>
        <di:waypoint x="1275" y="282"/>
        <di:waypoint x="1265" y="282"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M09_di" bpmnElement="M09">
        <di:waypoint x="1172" y="245"/>
        <di:waypoint x="1172" y="100"/>
        <di:waypoint x="875" y="100"/>
        <di:waypoint x="875" y="148"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M08_Yes_di" bpmnElement="M08_Yes">
        <di:waypoint x="1300" y="433"/>
        <di:waypoint x="1350" y="433"/>
        <di:waypoint x="1350" y="190"/>
        <di:waypoint x="1400" y="190"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M10_di" bpmnElement="M10">
        <di:waypoint x="1580" y="190"/>
        <di:waypoint x="1605" y="190"/>
        <di:waypoint x="1605" y="433"/>
        <di:waypoint x="1630" y="433"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M11_Yes_di" bpmnElement="M11_Yes">
        <di:waypoint x="1680" y="433"/>
        <di:waypoint x="1740" y="433"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M11_No_di" bpmnElement="M11_No">
        <di:waypoint x="1655" y="458"/>
        <di:waypoint x="1655" y="518"/>
        <di:waypoint x="1740" y="518"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M12_di" bpmnElement="M12">
        <di:waypoint x="1925" y="433"/>
        <di:waypoint x="1950" y="433"/>
        <di:waypoint x="1950" y="455"/>
        <di:waypoint x="1980" y="455"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M13_di" bpmnElement="M13">
        <di:waypoint x="1925" y="518"/>
        <di:waypoint x="2005" y="518"/>
        <di:waypoint x="2005" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M14_di" bpmnElement="M14">
        <di:waypoint x="2030" y="455"/>
        <di:waypoint x="2090" y="455"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
