<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Methodology" targetNamespace="https://grafio.example/bpmn">
  <bpmn:process id="Process_MethodologyPublication" name="Публикация методики" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Methodology"><bpmn:lane id="Lane_AdminAnalysis" name="Администратор Grafio"><bpmn:flowNodeRef>Start_M</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConfirmScope</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AnalyseOperations</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Ready</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RequestMoreData</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_DraftVersion</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Apply</bpmn:flowNodeRef><bpmn:flowNodeRef>End_M</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Calculation" name="Контур расчёта Grafio"><bpmn:flowNodeRef>Task_RunControl</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Recalculate</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ApplyForward</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:dataObject id="Data_RuleDraft" name="Проект правила"/><bpmn:dataObjectReference id="DataRef_RuleDraft" dataObjectRef="Data_RuleDraft" name="Проект правила"/><bpmn:dataObject id="Data_PublishedRule" name="Опубликованная версия"/><bpmn:dataObjectReference id="DataRef_PublishedRule" dataObjectRef="Data_PublishedRule" name="Версия методики"/>
    <bpmn:startEvent id="Start_M" name="Кейс готов к решению"><bpmn:outgoing>M01</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="Task_ConfirmScope" name="Подтвердить область и период"><bpmn:incoming>M01</bpmn:incoming><bpmn:outgoing>M02</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_AnalyseOperations" name="Проверить операции и действующее правило"><bpmn:incoming>M02</bpmn:incoming><bpmn:outgoing>M03</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Task_RunControl" name="Выполнить контрольный расчёт и сверку"><bpmn:incoming>M03</bpmn:incoming><bpmn:outgoing>M04</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Gateway_Ready" name="Условия публикации выполнены?"><bpmn:incoming>M04</bpmn:incoming><bpmn:outgoing>M05_Yes</bpmn:outgoing><bpmn:outgoing>M05_No</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_RequestMoreData" name="Запросить данные или исправить проект"><bpmn:incoming>M05_No</bpmn:incoming><bpmn:outgoing>M06</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="End_Wait" name="Ожидание данных"><bpmn:incoming>M06</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="Task_DraftVersion" name="Опубликовать новую версию методики"><bpmn:incoming>M05_Yes</bpmn:incoming><bpmn:outgoing>M07</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_Apply" name="Пересчитать историю?"><bpmn:incoming>M07</bpmn:incoming><bpmn:outgoing>M08_Yes</bpmn:outgoing><bpmn:outgoing>M08_No</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Task_Recalculate" name="Создать новые версии затронутых недель"><bpmn:incoming>M08_Yes</bpmn:incoming><bpmn:outgoing>M09</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Task_ApplyForward" name="Применить с выбранной даты"><bpmn:incoming>M08_No</bpmn:incoming><bpmn:outgoing>M10</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="End_M" name="Результат передан клиенту"><bpmn:incoming>M09</bpmn:incoming><bpmn:incoming>M10</bpmn:incoming></bpmn:endEvent>
    <bpmn:association id="Assoc_Draft" sourceRef="Task_AnalyseOperations" targetRef="DataRef_RuleDraft"/><bpmn:association id="Assoc_Published" sourceRef="Task_DraftVersion" targetRef="DataRef_PublishedRule"/><bpmn:sequenceFlow id="M01" sourceRef="Start_M" targetRef="Task_ConfirmScope"/><bpmn:sequenceFlow id="M02" sourceRef="Task_ConfirmScope" targetRef="Task_AnalyseOperations"/><bpmn:sequenceFlow id="M03" sourceRef="Task_AnalyseOperations" targetRef="Task_RunControl"/><bpmn:sequenceFlow id="M04" sourceRef="Task_RunControl" targetRef="Gateway_Ready"/><bpmn:sequenceFlow id="M05_Yes" name="да" sourceRef="Gateway_Ready" targetRef="Task_DraftVersion"/><bpmn:sequenceFlow id="M05_No" name="нет" sourceRef="Gateway_Ready" targetRef="Task_RequestMoreData"/><bpmn:sequenceFlow id="M06" sourceRef="Task_RequestMoreData" targetRef="End_Wait"/><bpmn:sequenceFlow id="M07" sourceRef="Task_DraftVersion" targetRef="Gateway_Apply"/><bpmn:sequenceFlow id="M08_Yes" name="да" sourceRef="Gateway_Apply" targetRef="Task_Recalculate"/><bpmn:sequenceFlow id="M08_No" name="нет" sourceRef="Gateway_Apply" targetRef="Task_ApplyForward"/><bpmn:sequenceFlow id="M09" sourceRef="Task_Recalculate" targetRef="End_M"/><bpmn:sequenceFlow id="M10" sourceRef="Task_ApplyForward" targetRef="End_M"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Methodology"><bpmndi:BPMNPlane id="Plane_Methodology" bpmnElement="Process_MethodologyPublication">
    <bpmndi:BPMNShape id="Lane_AdminAnalysis_di" bpmnElement="Lane_AdminAnalysis" isHorizontal="true"><dc:Bounds x="60" y="60" width="1700" height="190"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_Calculation_di" bpmnElement="Lane_Calculation" isHorizontal="true"><dc:Bounds x="60" y="250" width="1700" height="180"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Start_M_di" bpmnElement="Start_M"><dc:Bounds x="130" y="137" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_ConfirmScope_di" bpmnElement="Task_ConfirmScope"><dc:Bounds x="210" y="112" width="150" height="86"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_AnalyseOperations_di" bpmnElement="Task_AnalyseOperations"><dc:Bounds x="415" y="112" width="185" height="86"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_RunControl_di" bpmnElement="Task_RunControl"><dc:Bounds x="660" y="297" width="185" height="86"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gateway_Ready_di" bpmnElement="Gateway_Ready" isMarkerVisible="true"><dc:Bounds x="900" y="315" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_RequestMoreData_di" bpmnElement="Task_RequestMoreData"><dc:Bounds x="1010" y="297" width="185" height="86"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_Wait_di" bpmnElement="End_Wait"><dc:Bounds x="1240" y="322" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_DraftVersion_di" bpmnElement="Task_DraftVersion"><dc:Bounds x="1010" y="112" width="185" height="86"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gateway_Apply_di" bpmnElement="Gateway_Apply" isMarkerVisible="true"><dc:Bounds x="1250" y="130" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_Recalculate_di" bpmnElement="Task_Recalculate"><dc:Bounds x="1350" y="270" width="190" height="86"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_ApplyForward_di" bpmnElement="Task_ApplyForward"><dc:Bounds x="1350" y="365" width="190" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_M_di" bpmnElement="End_M"><dc:Bounds x="1590" y="322" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DataRef_RuleDraft_di" bpmnElement="DataRef_RuleDraft"><dc:Bounds x="490" y="70" width="36" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DataRef_PublishedRule_di" bpmnElement="DataRef_PublishedRule"><dc:Bounds x="1080" y="70" width="36" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="M01_di" bpmnElement="M01"><di:waypoint x="166" y="155"/><di:waypoint x="210" y="155"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="M02_di" bpmnElement="M02"><di:waypoint x="360" y="155"/><di:waypoint x="415" y="155"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="M03_di" bpmnElement="M03"><di:waypoint x="600" y="155"/><di:waypoint x="630" y="155"/><di:waypoint x="630" y="340"/><di:waypoint x="660" y="340"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="M04_di" bpmnElement="M04"><di:waypoint x="845" y="340"/><di:waypoint x="900" y="340"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="M05_Yes_di" bpmnElement="M05_Yes"><di:waypoint x="925" y="315"/><di:waypoint x="925" y="155"/><di:waypoint x="1010" y="155"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="M05_No_di" bpmnElement="M05_No"><di:waypoint x="950" y="340"/><di:waypoint x="1010" y="340"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="M06_di" bpmnElement="M06"><di:waypoint x="1195" y="340"/><di:waypoint x="1240" y="340"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="M07_di" bpmnElement="M07"><di:waypoint x="1195" y="155"/><di:waypoint x="1250" y="155"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="M08_Yes_di" bpmnElement="M08_Yes"><di:waypoint x="1275" y="180"/><di:waypoint x="1275" y="313"/><di:waypoint x="1350" y="313"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="M08_No_di" bpmnElement="M08_No"><di:waypoint x="1300" y="155"/><di:waypoint x="1320" y="155"/><di:waypoint x="1320" y="390"/><di:waypoint x="1350" y="390"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="M09_di" bpmnElement="M09"><di:waypoint x="1540" y="313"/><di:waypoint x="1590" y="340"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="M10_di" bpmnElement="M10"><di:waypoint x="1540" y="390"/><di:waypoint x="1570" y="390"/><di:waypoint x="1570" y="340"/><di:waypoint x="1590" y="340"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
