<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Plan" targetNamespace="https://grafio.example/bpmn">
  <bpmn:process id="Process_PlanLifecycle" name="Жизненный цикл плана" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Plan"><bpmn:lane id="Lane_PlanUser" name="Владелец / аналитик"><bpmn:flowNodeRef>Start_P</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CreateDraft</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_EditDraft</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ActivatePlan</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_PlanChanged</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CreateRevision</bpmn:flowNodeRef><bpmn:flowNodeRef>End_P</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_PlanSystem" name="Grafio"><bpmn:flowNodeRef>Task_ValidatePlan</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_PlanValid</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CompareFact</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:dataObject id="Data_PlanVersion" name="Версия плана"/><bpmn:dataObjectReference id="DataRef_PlanVersion" dataObjectRef="Data_PlanVersion" name="Версия плана"/>
    <bpmn:startEvent id="Start_P" name="Нужен план"><bpmn:outgoing>P01</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="Task_CreateDraft" name="Создать черновик плана"><bpmn:incoming>P01</bpmn:incoming><bpmn:incoming>P_Loop</bpmn:incoming><bpmn:incoming>P_RevisionLoop</bpmn:incoming><bpmn:outgoing>P02</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Task_ValidatePlan" name="Проверить область, период, единицу и методику"><bpmn:incoming>P02</bpmn:incoming><bpmn:outgoing>P03</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Gateway_PlanValid" name="План совместим с фактом?"><bpmn:incoming>P03</bpmn:incoming><bpmn:outgoing>P04_Yes</bpmn:outgoing><bpmn:outgoing>P04_No</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_EditDraft" name="Исправить черновик"><bpmn:incoming>P04_No</bpmn:incoming><bpmn:outgoing>P_Loop</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_ActivatePlan" name="Активировать версию плана"><bpmn:incoming>P04_Yes</bpmn:incoming><bpmn:outgoing>P05</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Task_CompareFact" name="Сопоставить факт и план"><bpmn:incoming>P05</bpmn:incoming><bpmn:outgoing>P06</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Gateway_PlanChanged" name="Нужна новая версия?"><bpmn:incoming>P06</bpmn:incoming><bpmn:outgoing>P07_Yes</bpmn:outgoing><bpmn:outgoing>P07_No</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_CreateRevision" name="Зафиксировать новую версию"><bpmn:incoming>P07_Yes</bpmn:incoming><bpmn:outgoing>P_RevisionLoop</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="End_P" name="Активный план используется"><bpmn:incoming>P07_No</bpmn:incoming></bpmn:endEvent>
    <bpmn:association id="Assoc_PlanVersion" sourceRef="Task_ActivatePlan" targetRef="DataRef_PlanVersion"/><bpmn:sequenceFlow id="P01" sourceRef="Start_P" targetRef="Task_CreateDraft"/><bpmn:sequenceFlow id="P02" sourceRef="Task_CreateDraft" targetRef="Task_ValidatePlan"/><bpmn:sequenceFlow id="P03" sourceRef="Task_ValidatePlan" targetRef="Gateway_PlanValid"/><bpmn:sequenceFlow id="P04_Yes" name="да" sourceRef="Gateway_PlanValid" targetRef="Task_ActivatePlan"/><bpmn:sequenceFlow id="P04_No" name="нет" sourceRef="Gateway_PlanValid" targetRef="Task_EditDraft"/><bpmn:sequenceFlow id="P_Loop" sourceRef="Task_EditDraft" targetRef="Task_CreateDraft"/><bpmn:sequenceFlow id="P05" sourceRef="Task_ActivatePlan" targetRef="Task_CompareFact"/><bpmn:sequenceFlow id="P06" sourceRef="Task_CompareFact" targetRef="Gateway_PlanChanged"/><bpmn:sequenceFlow id="P07_Yes" name="да" sourceRef="Gateway_PlanChanged" targetRef="Task_CreateRevision"/><bpmn:sequenceFlow id="P07_No" name="нет" sourceRef="Gateway_PlanChanged" targetRef="End_P"/><bpmn:sequenceFlow id="P_RevisionLoop" sourceRef="Task_CreateRevision" targetRef="Task_CreateDraft"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Plan"><bpmndi:BPMNPlane id="Plane_Plan" bpmnElement="Process_PlanLifecycle">
    <bpmndi:BPMNShape id="Lane_PlanUser_di" bpmnElement="Lane_PlanUser" isHorizontal="true"><dc:Bounds x="60" y="60" width="1450" height="180"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_PlanSystem_di" bpmnElement="Lane_PlanSystem" isHorizontal="true"><dc:Bounds x="60" y="240" width="1450" height="180"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Start_P_di" bpmnElement="Start_P"><dc:Bounds x="130" y="132" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_CreateDraft_di" bpmnElement="Task_CreateDraft"><dc:Bounds x="210" y="107" width="155" height="86"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_ValidatePlan_di" bpmnElement="Task_ValidatePlan"><dc:Bounds x="425" y="287" width="190" height="86"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gateway_PlanValid_di" bpmnElement="Gateway_PlanValid" isMarkerVisible="true"><dc:Bounds x="670" y="305" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_EditDraft_di" bpmnElement="Task_EditDraft"><dc:Bounds x="780" y="287" width="155" height="86"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_ActivatePlan_di" bpmnElement="Task_ActivatePlan"><dc:Bounds x="780" y="107" width="155" height="86"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_CompareFact_di" bpmnElement="Task_CompareFact"><dc:Bounds x="995" y="287" width="155" height="86"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gateway_PlanChanged_di" bpmnElement="Gateway_PlanChanged" isMarkerVisible="true"><dc:Bounds x="1205" y="125" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_CreateRevision_di" bpmnElement="Task_CreateRevision"><dc:Bounds x="1305" y="107" width="155" height="86"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_P_di" bpmnElement="End_P"><dc:Bounds x="1305" y="305" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DataRef_PlanVersion_di" bpmnElement="DataRef_PlanVersion"><dc:Bounds x="835" y="62" width="36" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="P01_di" bpmnElement="P01"><di:waypoint x="166" y="150"/><di:waypoint x="210" y="150"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="P02_di" bpmnElement="P02"><di:waypoint x="365" y="150"/><di:waypoint x="395" y="150"/><di:waypoint x="395" y="330"/><di:waypoint x="425" y="330"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="P03_di" bpmnElement="P03"><di:waypoint x="615" y="330"/><di:waypoint x="670" y="330"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="P04_Yes_di" bpmnElement="P04_Yes"><di:waypoint x="695" y="305"/><di:waypoint x="695" y="150"/><di:waypoint x="780" y="150"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="P04_No_di" bpmnElement="P04_No"><di:waypoint x="720" y="330"/><di:waypoint x="780" y="330"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="P_Loop_di" bpmnElement="P_Loop"><di:waypoint x="780" y="330"/><di:waypoint x="735" y="405"/><di:waypoint x="285" y="405"/><di:waypoint x="285" y="193"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="P05_di" bpmnElement="P05"><di:waypoint x="935" y="150"/><di:waypoint x="965" y="150"/><di:waypoint x="965" y="330"/><di:waypoint x="995" y="330"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="P06_di" bpmnElement="P06"><di:waypoint x="1150" y="330"/><di:waypoint x="1180" y="330"/><di:waypoint x="1180" y="150"/><di:waypoint x="1205" y="150"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="P07_Yes_di" bpmnElement="P07_Yes"><di:waypoint x="1255" y="150"/><di:waypoint x="1305" y="150"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="P07_No_di" bpmnElement="P07_No"><di:waypoint x="1230" y="175"/><di:waypoint x="1230" y="323"/><di:waypoint x="1305" y="323"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="P_RevisionLoop_di" bpmnElement="P_RevisionLoop"><di:waypoint x="1305" y="193"/><di:waypoint x="1280" y="220"/><di:waypoint x="285" y="220"/><di:waypoint x="285" y="193"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
