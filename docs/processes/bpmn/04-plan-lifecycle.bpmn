<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_PlanLifecycle" targetNamespace="https://grafio.example/bpmn">
  <bpmn:process id="Process_PlanLifecycle" name="Жизненный цикл плана" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_PlanLifecycle">
      <bpmn:lane id="Lane_User" name="Владелец / аналитик">
        <bpmn:flowNodeRef>Start_P</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EditDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Activate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Changed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_P</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Grafio">
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NewVersion</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_P" name="Нужен план">
      <bpmn:outgoing>P01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_CreateDraft" name="Создать черновик плана">
      <bpmn:incoming>P01</bpmn:incoming>
      <bpmn:outgoing>P02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Validate" name="Проверить область, период, единицу и методику">
      <bpmn:incoming>P02</bpmn:incoming>
      <bpmn:incoming>P05</bpmn:incoming>
      <bpmn:outgoing>P03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Valid" name="План совместим с фактом?">
      <bpmn:incoming>P03</bpmn:incoming>
      <bpmn:outgoing>P04_No</bpmn:outgoing>
      <bpmn:outgoing>P04_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_EditDraft" name="Исправить черновик">
      <bpmn:incoming>P04_No</bpmn:incoming>
      <bpmn:incoming>P09</bpmn:incoming>
      <bpmn:outgoing>P05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Activate" name="Активировать версию плана">
      <bpmn:incoming>P04_Yes</bpmn:incoming>
      <bpmn:outgoing>P06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Compare" name="Сопоставить факт и план">
      <bpmn:incoming>P06</bpmn:incoming>
      <bpmn:outgoing>P07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Changed" name="План нужно изменить?">
      <bpmn:incoming>P07</bpmn:incoming>
      <bpmn:outgoing>P08_No</bpmn:outgoing>
      <bpmn:outgoing>P08_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_NewVersion" name="Создать черновик новой версии">
      <bpmn:incoming>P08_Yes</bpmn:incoming>
      <bpmn:outgoing>P09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_P" name="Активный план используется">
      <bpmn:incoming>P08_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P01" sourceRef="Start_P" targetRef="Task_CreateDraft"/>
    <bpmn:sequenceFlow id="P02" sourceRef="Task_CreateDraft" targetRef="Task_Validate"/>
    <bpmn:sequenceFlow id="P03" sourceRef="Task_Validate" targetRef="Gateway_Valid"/>
    <bpmn:sequenceFlow id="P04_No" sourceRef="Gateway_Valid" targetRef="Task_EditDraft" name="нет"/>
    <bpmn:sequenceFlow id="P05" sourceRef="Task_EditDraft" targetRef="Task_Validate"/>
    <bpmn:sequenceFlow id="P04_Yes" sourceRef="Gateway_Valid" targetRef="Task_Activate" name="да"/>
    <bpmn:sequenceFlow id="P06" sourceRef="Task_Activate" targetRef="Task_Compare"/>
    <bpmn:sequenceFlow id="P07" sourceRef="Task_Compare" targetRef="Gateway_Changed"/>
    <bpmn:sequenceFlow id="P08_No" sourceRef="Gateway_Changed" targetRef="End_P" name="нет"/>
    <bpmn:sequenceFlow id="P08_Yes" sourceRef="Gateway_Changed" targetRef="Task_NewVersion" name="да"/>
    <bpmn:sequenceFlow id="P09" sourceRef="Task_NewVersion" targetRef="Task_EditDraft"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_PlanLifecycle">
    <bpmndi:BPMNPlane id="Plane_Process_PlanLifecycle" bpmnElement="Process_PlanLifecycle">
      <bpmndi:BPMNShape id="Lane_User_di" bpmnElement="Lane_User" isHorizontal="true">
        <dc:Bounds x="60" y="60" width="1530" height="265"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="60" y="325" width="1530" height="295"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_P_di" bpmnElement="Start_P">
        <dc:Bounds x="120" y="145" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateDraft_di" bpmnElement="Task_CreateDraft">
        <dc:Bounds x="205" y="120" width="165" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Validate_di" bpmnElement="Task_Validate">
        <dc:Bounds x="430" y="380" width="190" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Valid_di" bpmnElement="Gateway_Valid" isMarkerVisible="true">
        <dc:Bounds x="675" y="398" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EditDraft_di" bpmnElement="Task_EditDraft">
        <dc:Bounds x="790" y="235" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Activate_di" bpmnElement="Task_Activate">
        <dc:Bounds x="790" y="120" width="170" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Compare_di" bpmnElement="Task_Compare">
        <dc:Bounds x="1025" y="380" width="180" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Changed_di" bpmnElement="Gateway_Changed" isMarkerVisible="true">
        <dc:Bounds x="1260" y="138" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NewVersion_di" bpmnElement="Task_NewVersion">
        <dc:Bounds x="1370" y="380" width="190" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_P_di" bpmnElement="End_P">
        <dc:Bounds x="1410" y="145" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P01_di" bpmnElement="P01">
        <di:waypoint x="156" y="163"/>
        <di:waypoint x="205" y="163"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_di" bpmnElement="P02">
        <di:waypoint x="370" y="163"/>
        <di:waypoint x="400" y="163"/>
        <di:waypoint x="400" y="423"/>
        <di:waypoint x="430" y="423"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P03_di" bpmnElement="P03">
        <di:waypoint x="620" y="423"/>
        <di:waypoint x="675" y="423"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_No_di" bpmnElement="P04_No">
        <di:waypoint x="725" y="423"/>
        <di:waypoint x="750" y="423"/>
        <di:waypoint x="750" y="275"/>
        <di:waypoint x="790" y="275"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P05_di" bpmnElement="P05">
        <di:waypoint x="875" y="315"/>
        <di:waypoint x="875" y="535"/>
        <di:waypoint x="525" y="535"/>
        <di:waypoint x="525" y="466"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_Yes_di" bpmnElement="P04_Yes">
        <di:waypoint x="700" y="398"/>
        <di:waypoint x="700" y="163"/>
        <di:waypoint x="790" y="163"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P06_di" bpmnElement="P06">
        <di:waypoint x="960" y="163"/>
        <di:waypoint x="1005" y="163"/>
        <di:waypoint x="1005" y="423"/>
        <di:waypoint x="1025" y="423"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P07_di" bpmnElement="P07">
        <di:waypoint x="1205" y="423"/>
        <di:waypoint x="1230" y="423"/>
        <di:waypoint x="1230" y="163"/>
        <di:waypoint x="1260" y="163"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P08_No_di" bpmnElement="P08_No">
        <di:waypoint x="1310" y="163"/>
        <di:waypoint x="1410" y="163"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P08_Yes_di" bpmnElement="P08_Yes">
        <di:waypoint x="1285" y="188"/>
        <di:waypoint x="1285" y="423"/>
        <di:waypoint x="1370" y="423"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P09_di" bpmnElement="P09">
        <di:waypoint x="1465" y="466"/>
        <di:waypoint x="1465" y="580"/>
        <di:waypoint x="980" y="580"/>
        <di:waypoint x="980" y="275"/>
        <di:waypoint x="960" y="275"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
