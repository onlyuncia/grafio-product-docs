<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Offboarding" targetNamespace="https://grafio.example/bpmn">
  <bpmn:process id="Process_Offboarding" name="Закрытие клиента и удаление данных" isExecutable="false">
    <bpmn:laneSet id="Lanes_Offboarding">
      <bpmn:lane id="Lane_ClientClose" name="Владелец клиента">
        <bpmn:flowNodeRef>Start_C</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestClose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmExport</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GrafioClose" name="Grafio: поддержка и данные">
        <bpmn:flowNodeRef>Task_ValidateGrounds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Export</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareExport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StopIntegrations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArchiveRecord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApplyRetention</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DeleteDue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeleteData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScheduleRecheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Recheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_C</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_C" name="Основание закрыть организацию">
      <bpmn:outgoing>C01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_RequestClose" name="Подтвердить запрос закрытия">
      <bpmn:incoming>C01</bpmn:incoming>
      <bpmn:outgoing>C02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ValidateGrounds" name="Проверить основание и полномочия">
      <bpmn:incoming>C02</bpmn:incoming>
      <bpmn:outgoing>C03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Export" name="Нужна выгрузка данных?">
      <bpmn:incoming>C03</bpmn:incoming>
      <bpmn:outgoing>C04_Yes</bpmn:outgoing>
      <bpmn:outgoing>C04_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_PrepareExport" name="Подготовить контролируемую выгрузку">
      <bpmn:incoming>C04_Yes</bpmn:incoming>
      <bpmn:outgoing>C05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ConfirmExport" name="Получить выгрузку">
      <bpmn:incoming>C05</bpmn:incoming>
      <bpmn:outgoing>C06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_StopIntegrations" name="Отозвать токены и остановить загрузки">
      <bpmn:incoming>C04_No</bpmn:incoming>
      <bpmn:incoming>C06</bpmn:incoming>
      <bpmn:outgoing>C07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ArchiveRecord" name="Зафиксировать закрытие и состав хранения">
      <bpmn:incoming>C07</bpmn:incoming>
      <bpmn:outgoing>C08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Task_ApplyRetention" name="Истёк срок хранения">
      <bpmn:incoming>C08</bpmn:incoming>
      <bpmn:outgoing>C09</bpmn:outgoing>
      <bpmn:timerEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_DeleteDue" name="Нет удерживающих зависимостей?">
      <bpmn:incoming>C09</bpmn:incoming>
      <bpmn:outgoing>C10_Yes</bpmn:outgoing>
      <bpmn:outgoing>C10_No</bpmn:outgoing>
      <bpmn:incoming>C13</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_DeleteData" name="Удалить данные и записать результат">
      <bpmn:incoming>C10_Yes</bpmn:incoming>
      <bpmn:outgoing>C11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ScheduleRecheck" name="Отложить удаление и назначить проверку">
      <bpmn:incoming>C10_No</bpmn:incoming>
      <bpmn:outgoing>C12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_Recheck" name="Срок повторной проверки">
      <bpmn:incoming>C12</bpmn:incoming>
      <bpmn:outgoing>C13</bpmn:outgoing>
      <bpmn:timerEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_C" name="Удаление завершено">
      <bpmn:incoming>C11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="C01" sourceRef="Start_C" targetRef="Task_RequestClose"/>
    <bpmn:sequenceFlow id="C02" sourceRef="Task_RequestClose" targetRef="Task_ValidateGrounds"/>
    <bpmn:sequenceFlow id="C03" sourceRef="Task_ValidateGrounds" targetRef="Gateway_Export"/>
    <bpmn:sequenceFlow id="C04_Yes" name="да" sourceRef="Gateway_Export" targetRef="Task_PrepareExport"/>
    <bpmn:sequenceFlow id="C04_No" name="нет" sourceRef="Gateway_Export" targetRef="Task_StopIntegrations"/>
    <bpmn:sequenceFlow id="C05" sourceRef="Task_PrepareExport" targetRef="Task_ConfirmExport"/>
    <bpmn:sequenceFlow id="C06" sourceRef="Task_ConfirmExport" targetRef="Task_StopIntegrations"/>
    <bpmn:sequenceFlow id="C07" sourceRef="Task_StopIntegrations" targetRef="Task_ArchiveRecord"/>
    <bpmn:sequenceFlow id="C08" sourceRef="Task_ArchiveRecord" targetRef="Task_ApplyRetention"/>
    <bpmn:sequenceFlow id="C09" sourceRef="Task_ApplyRetention" targetRef="Gateway_DeleteDue"/>
    <bpmn:sequenceFlow id="C10_Yes" name="да" sourceRef="Gateway_DeleteDue" targetRef="Task_DeleteData"/>
    <bpmn:sequenceFlow id="C10_No" name="нет" sourceRef="Gateway_DeleteDue" targetRef="Task_ScheduleRecheck"/>
    <bpmn:sequenceFlow id="C11" sourceRef="Task_DeleteData" targetRef="End_C"/>
    <bpmn:sequenceFlow id="C12" sourceRef="Task_ScheduleRecheck" targetRef="Event_Recheck"/>
    <bpmn:sequenceFlow id="C13" sourceRef="Event_Recheck" targetRef="Gateway_DeleteDue"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_Offboarding">
    <bpmndi:BPMNPlane id="Plane_Process_Offboarding" bpmnElement="Process_Offboarding">
      <bpmndi:BPMNShape id="Shape_Lane_ClientClose" bpmnElement="Lane_ClientClose">
        <dc:Bounds x="60" y="60" width="2310" height="165"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_GrafioClose" bpmnElement="Lane_GrafioClose">
        <dc:Bounds x="60" y="225" width="2310" height="285"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_C" bpmnElement="Start_C">
        <dc:Bounds x="120" y="125" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_RequestClose" bpmnElement="Task_RequestClose">
        <dc:Bounds x="205" y="100" width="180" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ValidateGrounds" bpmnElement="Task_ValidateGrounds">
        <dc:Bounds x="435" y="285" width="180" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Export" bpmnElement="Gateway_Export">
        <dc:Bounds x="665" y="303" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_PrepareExport" bpmnElement="Task_PrepareExport">
        <dc:Bounds x="775" y="285" width="185" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ConfirmExport" bpmnElement="Task_ConfirmExport">
        <dc:Bounds x="1010" y="100" width="175" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_StopIntegrations" bpmnElement="Task_StopIntegrations">
        <dc:Bounds x="1235" y="285" width="190" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ArchiveRecord" bpmnElement="Task_ArchiveRecord">
        <dc:Bounds x="1475" y="285" width="190" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ApplyRetention" bpmnElement="Task_ApplyRetention">
        <dc:Bounds x="1715" y="310" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_DeleteDue" bpmnElement="Gateway_DeleteDue">
        <dc:Bounds x="1805" y="303" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_DeleteData" bpmnElement="Task_DeleteData">
        <dc:Bounds x="1905" y="285" width="190" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_C" bpmnElement="End_C">
        <dc:Bounds x="2140" y="310" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_C01" bpmnElement="C01">
        <di:waypoint x="156" y="143.0"/>
        <di:waypoint x="205" y="143.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_C02" bpmnElement="C02">
        <di:waypoint x="385" y="143.0"/>
        <di:waypoint x="410.0" y="143.0"/>
        <di:waypoint x="410.0" y="328.0"/>
        <di:waypoint x="435" y="328.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_C03" bpmnElement="C03">
        <di:waypoint x="615" y="328.0"/>
        <di:waypoint x="665" y="328.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_C04_Yes" bpmnElement="C04_Yes">
        <di:waypoint x="715" y="328"/>
        <di:waypoint x="775" y="328"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_C04_No" bpmnElement="C04_No">
        <di:waypoint x="690" y="353"/>
        <di:waypoint x="690" y="405"/>
        <di:waypoint x="1330" y="405"/>
        <di:waypoint x="1330" y="371"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_C05" bpmnElement="C05">
        <di:waypoint x="960" y="328"/>
        <di:waypoint x="985" y="328"/>
        <di:waypoint x="985" y="143"/>
        <di:waypoint x="1010" y="143"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_C06" bpmnElement="C06">
        <di:waypoint x="1185" y="143"/>
        <di:waypoint x="1210" y="143"/>
        <di:waypoint x="1210" y="328"/>
        <di:waypoint x="1235" y="328"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_C07" bpmnElement="C07">
        <di:waypoint x="1425" y="328.0"/>
        <di:waypoint x="1475" y="328.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_C08" bpmnElement="C08">
        <di:waypoint x="1665" y="328.0"/>
        <di:waypoint x="1715" y="328.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_C09" bpmnElement="C09">
        <di:waypoint x="1751" y="328.0"/>
        <di:waypoint x="1805" y="328.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_C10_Yes" bpmnElement="C10_Yes">
        <di:waypoint x="1855" y="328"/>
        <di:waypoint x="1905" y="328"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_C10_No" bpmnElement="C10_No">
        <di:waypoint x="1830" y="353"/>
        <di:waypoint x="1830" y="485"/>
        <di:waypoint x="2000" y="485"/>
        <di:waypoint x="2000" y="460"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_C11" bpmnElement="C11">
        <di:waypoint x="2095" y="328"/>
        <di:waypoint x="2140" y="328"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Shape_Task_ScheduleRecheck" bpmnElement="Task_ScheduleRecheck">
        <dc:Bounds x="1905" y="390" width="190" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Event_Recheck" bpmnElement="Event_Recheck">
        <dc:Bounds x="2160" y="407" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_C12" bpmnElement="C12">
        <di:waypoint x="2095" y="425"/>
        <di:waypoint x="2160" y="425"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_C13" bpmnElement="C13">
        <di:waypoint x="2196" y="425"/>
        <di:waypoint x="2240" y="425"/>
        <di:waypoint x="2240" y="245"/>
        <di:waypoint x="1830" y="245"/>
        <di:waypoint x="1830" y="303"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
