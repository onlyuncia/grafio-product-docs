<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Offboarding" targetNamespace="https://grafio.example/bpmn"><bpmn:process id="Process_Offboarding" name="Закрытие клиента и удаление данных" isExecutable="false"><bpmn:laneSet id="Lanes_Offboarding"><bpmn:lane id="Lane_ClientClose" name="Владелец клиента"><bpmn:flowNodeRef>Start_C</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RequestClose</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConfirmExport</bpmn:flowNodeRef><bpmn:flowNodeRef>End_C</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_GrafioClose" name="Grafio: поддержка и данные"><bpmn:flowNodeRef>Task_ValidateGrounds</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Export</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_PrepareExport</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_StopIntegrations</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ArchiveRecord</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ApplyRetention</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_DeleteDue</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_DeleteData</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Start_C" name="Основание закрыть организацию"><bpmn:outgoing>C01</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="Task_RequestClose" name="Подтвердить запрос закрытия"><bpmn:incoming>C01</bpmn:incoming><bpmn:outgoing>C02</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_ValidateGrounds" name="Проверить основание и полномочия"><bpmn:incoming>C02</bpmn:incoming><bpmn:outgoing>C03</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_Export" name="Нужна выгрузка данных?"><bpmn:incoming>C03</bpmn:incoming><bpmn:outgoing>C04_Yes</bpmn:outgoing><bpmn:outgoing>C04_No</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Task_PrepareExport" name="Подготовить контролируемую выгрузку"><bpmn:incoming>C04_Yes</bpmn:incoming><bpmn:outgoing>C05</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="Task_ConfirmExport" name="Получить выгрузку"><bpmn:incoming>C05</bpmn:incoming><bpmn:outgoing>C06</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Task_StopIntegrations" name="Отозвать токены и остановить загрузки"><bpmn:incoming>C04_No</bpmn:incoming><bpmn:incoming>C06</bpmn:incoming><bpmn:outgoing>C07</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Task_ArchiveRecord" name="Зафиксировать закрытие и состав хранения"><bpmn:incoming>C07</bpmn:incoming><bpmn:outgoing>C08</bpmn:outgoing></bpmn:serviceTask><bpmn:intermediateCatchEvent id="Task_ApplyRetention" name="Истёк срок хранения"><bpmn:incoming>C08</bpmn:incoming><bpmn:outgoing>C09</bpmn:outgoing><bpmn:timerEventDefinition/></bpmn:intermediateCatchEvent><bpmn:exclusiveGateway id="Gateway_DeleteDue" name="Нет удерживающих зависимостей?"><bpmn:incoming>C09</bpmn:incoming><bpmn:outgoing>C10_Yes</bpmn:outgoing><bpmn:outgoing>C10_No</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Task_DeleteData" name="Удалить данные и записать результат"><bpmn:incoming>C10_Yes</bpmn:incoming><bpmn:outgoing>C11</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="End_C" name="Закрытие завершено"><bpmn:incoming>C10_No</bpmn:incoming><bpmn:incoming>C11</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="C01" sourceRef="Start_C" targetRef="Task_RequestClose"/><bpmn:sequenceFlow id="C02" sourceRef="Task_RequestClose" targetRef="Task_ValidateGrounds"/><bpmn:sequenceFlow id="C03" sourceRef="Task_ValidateGrounds" targetRef="Gateway_Export"/><bpmn:sequenceFlow id="C04_Yes" name="да" sourceRef="Gateway_Export" targetRef="Task_PrepareExport"/><bpmn:sequenceFlow id="C04_No" name="нет" sourceRef="Gateway_Export" targetRef="Task_StopIntegrations"/><bpmn:sequenceFlow id="C05" sourceRef="Task_PrepareExport" targetRef="Task_ConfirmExport"/><bpmn:sequenceFlow id="C06" sourceRef="Task_ConfirmExport" targetRef="Task_StopIntegrations"/><bpmn:sequenceFlow id="C07" sourceRef="Task_StopIntegrations" targetRef="Task_ArchiveRecord"/><bpmn:sequenceFlow id="C08" sourceRef="Task_ArchiveRecord" targetRef="Task_ApplyRetention"/><bpmn:sequenceFlow id="C09" sourceRef="Task_ApplyRetention" targetRef="Gateway_DeleteDue"/><bpmn:sequenceFlow id="C10_Yes" name="да" sourceRef="Gateway_DeleteDue" targetRef="Task_DeleteData"/><bpmn:sequenceFlow id="C10_No" name="нет" sourceRef="Gateway_DeleteDue" targetRef="End_C"/><bpmn:sequenceFlow id="C11" sourceRef="Task_DeleteData" targetRef="End_C"/></bpmn:process></bpmn:definitions>
