@startuml
!include <C4/C4_Component>

HIDE_STEREOTYPE()
title C3 — Отчётность, контроль и методика API Grafio

Container_Ext(web, "Клиентское приложение", "React", "Отчёты и кейсы.")
Container_Ext(adminWeb, "Панель администратора", "React", "Расследования и правила.")
Container_Ext(worker, "Фоновый обработчик", "BullMQ", "Финансовый расчёт.")
ContainerDb_Ext(db, "PostgreSQL", "Операции и версии.")
ContainerQueue_Ext(queue, "Redis", "Задания пересчёта.")

Container_Boundary(api, "Сервер приложений Grafio") {
  Component(reporting, "Расчёт и отчётность", "Fastify", "Показатели, качество и версии.")
  Component(cases, "Контроль расчётов", "Fastify", "Кейсы и доказательства.")
  Component(methodology, "Методика", "Fastify", "Правила, проверки и публикация.")
  Component(audit, "Аудит и задания", "Fastify", "События и статусы заданий.")
}

Rel(web, reporting, "Читает отчёты", "HTTPS")
Rel(web, cases, "Ведёт кейсы", "HTTPS")
Rel(adminWeb, methodology, "Управляет правилами", "HTTPS")
Rel(worker, reporting, "Передаёт результат", "Внутренний контракт")
Rel(cases, methodology, "Передаёт расследование", "Внутренний вызов")
Rel(reporting, db, "Показатели и версии", "SQL")
Rel(cases, db, "Кейсы", "SQL")
Rel(methodology, db, "Правила", "SQL")
Rel(audit, db, "События", "SQL")
Rel(methodology, queue, "Ставит пересчёт", "Redis")
Rel(audit, queue, "Читает статусы", "Redis")

@enduml
