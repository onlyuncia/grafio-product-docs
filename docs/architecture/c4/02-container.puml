@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
title C4 — уровень 2. Контейнеры целевого финансового контура Grafio

Person(client, "Пользователь клиента", "Владелец, финансист, аналитик, менеджер или наблюдатель.")
Person(admin, "Администратор Grafio", "Работает с методикой и расследованиями.")
System_Ext(wb, "Wildberries API", "Источник финансовых данных.")

System_Boundary(grafio, "Grafio") {
  Container(web, "Клиентское веб-приложение", "React", "Отчёт, аналитика, планы, команда, безопасность и «Мой дашборд».")
  Container(adminWeb, "Admin Console", "React", "Внутренняя очередь проблем, методика, контроль и публикация.")
  Container(api, "Сервер приложений", "Node.js / Fastify", "Модульный монолит: доступ, организации, отчёты, кейсы, планы, дашборд, аудит.")
  Container(worker, "Асинхронный worker", "Node.js / BullMQ", "Загрузка WB, нормализация, контроль качества, расчёт, пересчёт и уведомления.")
  ContainerDb(db, "Транзакционная БД", "PostgreSQL", "Метаданные, нормализованные операции, версии, планы, кейсы и аудит.")
  ContainerQueue(queue, "Очередь и кэш", "Redis", "Фоновые задания, повторы и ограничение нагрузки.")
  ContainerDb(raw, "Raw-хранилище", "Защищённое объектное хранилище", "Неизменяемые ответы WB и доказательства кейсов.")
  ContainerDb(secrets, "Хранилище секретов", "Secrets manager", "Токены внешних API; в БД хранится только ссылка на секрет.")
}

Rel(client, web, "Работает с сервисом", "HTTPS")
Rel(admin, adminWeb, "Работает с Admin Console", "HTTPS + MFA")
Rel(web, api, "Читает данные и отправляет команды", "JSON/HTTPS")
Rel(adminWeb, api, "Управляет расследованиями и методикой", "JSON/HTTPS")
Rel(api, db, "Читает и изменяет предметные данные", "SQL")
Rel(api, queue, "Создаёт фоновые задания", "Redis")
Rel(api, secrets, "Получает ссылки на секреты", "HTTPS")
Rel(worker, queue, "Получает и завершает задания", "Redis")
Rel(worker, wb, "Получает финансовые данные", "HTTPS API")
Rel(worker, raw, "Сохраняет raw-ответы и вложения", "HTTPS")
Rel(worker, db, "Сохраняет операции, качество и версии отчётов", "SQL")
Rel(worker, secrets, "Получает токены WB", "HTTPS")

@enduml
