@startuml
!include <C4/C4_Container>

HIDE_STEREOTYPE()
title C2 — Контейнеры Grafio

System_Ext(marketplaces, "API маркетплейсов", "Wildberries и Ozon.")

System_Boundary(grafio, "Grafio") {
  Container(web, "Клиентское веб-приложение", "React", "Отчёты, планы, дашборд и доступ.")
  Container(adminWeb, "Панель администратора", "React", "Расследования, правила и публикация.")
  Container(api, "Сервер приложений", "Node.js / Fastify", "Предметные модули Grafio.")
  Container(worker, "Фоновый обработчик", "Node.js / BullMQ", "Загрузка WB и Ozon; расчёт и пересчёт WB.")
  ContainerDb(db, "Транзакционная БД", "PostgreSQL", "Операции, версии, планы и кейсы.")
  ContainerQueue(queue, "Очередь заданий", "Redis", "Фоновые задания и повторы.")
  Container(raw, "Хранилище ответов", "Объектное хранилище", "Ответы маркетплейсов и вложения кейсов.")
  ContainerDb(secrets, "Хранилище секретов", "Secrets manager", "Токены внешних API.")
}

Rel(web, api, "Запросы")
Rel(adminWeb, api, "Решения")
Rel(api, db, "Данные")
Rel(api, queue, "Задания")
Rel(api, secrets, "Секреты")
Rel(worker, queue, "Берёт задания")
Rel(worker, marketplaces, "Синхронизирует данные")
Rel(worker, raw, "Исходные ответы")
Rel(worker, db, "Результаты")
Rel(worker, secrets, "Токены")

@enduml
