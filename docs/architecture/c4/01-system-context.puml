@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()
title C4 — уровень 1. Контекст системы Grafio

Person(client, "Владелец / финансист / аналитик", "Просматривает финансовый результат, исследует отклонения, ведёт планы и личный дашборд.")
Person(admin, "Администратор Grafio", "Исследует системные проблемы и публикует версии методики.")
System(grafio, "Grafio", "Аналитика продавцов WB и Ozon; проектируемый недельный финансовый контур детализирован для WB.")
System_Ext(wb, "Wildberries API", "Источник финансовых операций и данных кабинета.")
System_Ext(ozon, "Ozon API", "Источник данных существующей синхронизации Grafio.")

Rel(client, grafio, "Работает с отчётами, кейсами, планами, дашбордом и доступом", "HTTPS")
Rel(admin, grafio, "Работает во внутренней Admin Console", "HTTPS + MFA")
Rel(grafio, wb, "Запрашивает финансовые данные кабинета", "HTTPS API")
Rel(grafio, ozon, "Синхронизирует данные существующих разделов", "HTTPS API")

@enduml
