@startuml
title Последовательность 05а — регистрация организации и кабинета WB
autonumber
hide footbox

skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam sequence {
  ArrowColor #526274
  LifeLineBorderColor #94A3B8
  ParticipantBackgroundColor #EAF2FC
  ParticipantBorderColor #5289C2
  GroupBorderColor #64748B
  GroupHeaderBackgroundColor #EAF2FC
}

actor "Владелец организации" as Owner
boundary "Клиентское приложение" as UI
control "Организации и кабинеты" as Org
database "Хранилище секретов" as Secrets
database "PostgreSQL" as DB

Owner -> UI : Создаёт организацию и юридическое лицо
UI -> Org : POST /organization
Org -> DB : Сохранить организацию
DB --> Org : organizationId
Org --> UI : 201: организация
UI -> Org : POST /organization/legal-entities
Org -> DB : Сохранить юридическое лицо
DB --> Org : legalEntityId
Org --> UI : 201: юридическое лицо
Owner -> UI : Вводит идентификатор кабинета и токен WB
UI -> Org : POST /marketplace-accounts
Org -> Secrets : Сохранить токен
Secrets --> Org : secret_ref
Org -> DB : Создать кабинет «Черновик» и завершить\nзадание регистрации подключения
DB --> Org : jobId
Org --> UI : 202: jobId
UI -> Org : GET /jobs/{jobId} после завершения
Org -> DB : Прочитать результат задания
DB --> Org : job.result.accountId
Org --> UI : 200: завершено, result.accountId
UI --> Owner : Кабинет создан; запускается проверка доступа
@enduml
