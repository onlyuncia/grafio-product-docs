@startuml
title Последовательность — кейс клиента, методика и пересчёт
autonumber

actor "Финансист клиента" as Client
boundary "Клиентское приложение" as UI
control "Контроль расчётов" as Cases
database "PostgreSQL" as DB
boundary "Admin Console" as AdminUI
actor "Администратор Grafio" as Admin
control "Методика и версии" as Methodology
queue "Redis / очередь" as Queue
control "Worker расчёта" as Worker

Client -> UI : Создаёт кейс по расхождению\nили неизвестной операции
UI -> Cases : POST /calculation-cases
Cases -> DB : Сохранить контекст, период, сумму и статус new
Cases --> UI : Кейс создан
Client -> UI : Добавляет комментарий и доказательства
UI -> Cases : POST /comments, POST /evidence
Cases -> DB : Сохранить материалы кейса
Client -> UI : Отправляет кейс
UI -> Cases : POST /submit
Cases -> DB : Статус submitted, аудит и связанное расследование

Admin -> AdminUI : Открывает очередь расследований
AdminUI -> Methodology : GET /admin/investigations
Methodology -> DB : Получить кейс, операции и действующие правила
DB --> Methodology : Материалы расследования
Methodology --> AdminUI : Карточка расследования
Admin -> AdminUI : Создаёт черновик правила и контрольный запуск
AdminUI -> Methodology : POST /rule-drafts, POST /validation-runs
Methodology -> Queue : Запустить фоновую проверку
Queue -> Worker : Проверить контрольные загрузки
Worker -> DB : Сохранить результат проверки

alt Контроль пройден
  Admin -> AdminUI : Выбирает область, дату и способ применения
  AdminUI -> Methodology : POST /publish
  Methodology -> DB : Опубликовать неизменяемую версию методики
  Methodology -> Queue : Пересчитать историю или применить вперёд
  Queue -> Worker : Создать новые версии затронутых недель
  Worker -> DB : Сохранить новые версии отчётов\nи результат кейса
  Cases -> DB : Показать клиенту методику, сверку и объяснение
else Контроль не пройден
  Methodology -> DB : Черновик остаётся непубликованным
  Cases -> DB : Кейсу назначается needs_data или пояснение отказа
end
@enduml
