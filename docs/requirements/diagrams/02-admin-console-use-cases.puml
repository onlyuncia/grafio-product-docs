@startuml
left to right direction
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam packageStyle rectangle
skinparam ArrowColor #526274
skinparam usecaseBackgroundColor #EAF2FC
skinparam usecaseBorderColor #5289C2
skinparam rectangleBackgroundColor #F8FAFC
skinparam rectangleBorderColor #94A3B8
actor "Администратор Grafio" as Admin
actor "Клиентское приложение" as ClientApp
rectangle "Grafio: Admin Console" {
  usecase "Получить запрос\nклиента" as UA1
  usecase "Исследовать\nкейс и операции" as UA2
  usecase "Подготовить\nпроект правила" as UA3
  usecase "Выполнить\nконтроль и сверку" as UA4
  usecase "Опубликовать\nверсию методики" as UA5
  usecase "Пересчитать историю" as UA6
  usecase "Применить правило\nвперёд с даты" as UA7
  usecase "Передать результат\nв клиентское приложение" as UA8
  UA3 .> UA2 : <<include>>
  UA5 .> UA3 : <<include>>
  UA5 .> UA4 : <<include>>
  UA6 .> UA5 : <<extend>>
  UA7 .> UA5 : <<extend>>
  UA5 .> UA8 : <<include>>
}
ClientApp -- UA1
ClientApp -- UA8
Admin -- UA1
Admin -- UA2
Admin -- UA3
Admin -- UA5
@enduml
